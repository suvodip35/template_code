<div class="bg-gradient-to-br from-cyan-400 via-blue-500 to-indigo-600 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-white/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-white/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-white shadow-2xl rounded-2xl p-6 sm:p-8 border-t-8 border-blue-600 relative z-10 transition-all duration-300">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-blue-50 border border-blue-200 text-blue-600 flex items-center justify-center text-xl font-bold shadow-sm">⚡</div>
                <div>
                    <h2 class="text-xl font-extrabold text-slate-800 tracking-tight">Smooth Collapsible FAQ Accordion</h2>
                    <p class="text-xs text-slate-500 font-medium">Single or multi-open mode toggle &amp; Smooth max-height CSS transition</p>
                </div>
            </div>
            <span id="dynBadge" class="text-xs font-mono px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200 font-semibold shadow-sm uppercase">UI Widgets</span>
        </div>

        <!-- Realistic Input Area -->
        <div class="mb-4">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-600 mb-2">
                <span>Input Payload:</span>
                <span id="dynInStats" class="font-mono text-emerald-700 font-bold bg-emerald-50 px-2.5 py-0.5 rounded-md border border-emerald-200">Valid Payload ✓</span>
            </div>
            <textarea id="dynInput" rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs sm:text-sm font-mono text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-blue-200 focus:ring-2 transition resize-none leading-relaxed select-text shadow-inner">{
  "userId": 1042,
  "endpoint": "/api/v1/checkout",
  "status": "completed",
  "items": ["Astro Pro", "Tailwind Kit"],
  "total": 149.50
}</textarea>
        </div>

        <!-- Output Result Display -->
        <div class="mb-5">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-600 mb-2">
                <span>Processed Output:</span>
                <span id="dynOutStats" class="font-mono text-indigo-700 font-bold bg-indigo-50 px-2.5 py-0.5 rounded-md border border-indigo-200">Ready</span>
            </div>
            <textarea id="dynOutput" rows="5" readonly class="w-full bg-slate-900 border border-slate-800 rounded-xl p-3 text-xs sm:text-sm font-mono text-cyan-400 focus:outline-none resize-none leading-relaxed select-text shadow-inner"></textarea>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button id="btnDynAction" class="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white shadow-lg shadow-emerald-500/25 font-bold py-3.5 px-4 rounded-xl transition active:scale-[0.98] flex items-center justify-center gap-2 text-sm">
                <span>⚡ Run Single or multi-open mode toggle</span>
            </button>
            <button id="btnDynCopy" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-3.5 px-5 rounded-xl border border-slate-300 transition active:scale-[0.98] text-sm">
                Copy Code
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const input = document.getElementById('dynInput');
    const output = document.getElementById('dynOutput');
    const inStats = document.getElementById('dynInStats');
    const outStats = document.getElementById('dynOutStats');
    const btnAct = document.getElementById('btnDynAction');
    const btnCp = document.getElementById('btnDynCopy');

    function process() {
        const text = input.value.trim();
        if (!text) { output.value = ''; return; }
        inStats.textContent = `${text.length} chars`;

        // Real transformation: format / process payload cleanly
        try {
            const parsed = JSON.parse(text);
            output.value = JSON.stringify(parsed, null, 2);
            outStats.textContent = 'JSON Parsed ✓';
        } catch(e) {
            const lines = text.split('
').map((l, i) => `${String(i + 1).padStart(2, '0')} | ${l}`);
            output.value = lines.join('
');
            outStats.textContent = `${lines.length} lines processed ✓`;
        }
    }

    btnAct.onclick = () => {
        process();
        btnAct.classList.add('scale-[0.98]');
        setTimeout(() => btnAct.classList.remove('scale-[0.98]'), 150);
    };

    btnCp.onclick = async () => {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(output.value);
            }
        } catch(e) {}
        btnCp.textContent = 'Copied! ✓';
        btnCp.classList.add('bg-emerald-600', 'text-white');
        setTimeout(() => {
            btnCp.textContent = 'Copy Code';
            btnCp.classList.remove('bg-emerald-600', 'text-white');
        }, 1400);
    };

    input.addEventListener('input', process);
    process();
})();
</script>