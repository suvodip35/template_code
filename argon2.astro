<div class="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 min-h-screen flex items-center justify-center font-sans text-gray-800">
    <div class="bg-white shadow-lg rounded-lg p-6 w-full max-w-lg">
        <h1 class="text-2xl font-bold text-center text-purple-700 mb-4">
            Argon2 Password Hash Generator
        </h1>
        <form id="hashForm" class="space-y-4">
            <div>
                <label for="password" class="block font-semibold">
                    Password:
                </label>
                <div class="relative">
                    <input
                        type="password"
                        id="password"
                        class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
                        placeholder="Enter your Password"
                        required
                    />
                    <button
                        type="button"
                        id="toggleVisibility"
                        class="absolute right-2 top-2 text-purple-700">
                        Show
                    </button>
                </div>
                <div id="passwordStrength" class="mt-2 text-sm"></div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="iterations" class="block font-semibold">
                        Iterations:
                    </label>
                    <input
                        type="number"
                        id="iterations"
                        value="3"
                        min="1"
                        class="w-full px-4 py-2 border rounded-lg focus:outline-none fous:ring-2 focus:ring-purple-500"
                    />
                </div>
                <div>
                    <label for="memory" class="block font-semibold">
                        Memory (KB):
                    </label>
                    <input
                        type="number"
                        id="memory"
                        value="1024"
                        min="1024"
                        class="w-full px-4 py-2 border rounded-lg focus:outline-none fous:ring-2 focus:ring-purple-500"
                    />
                </div>
                <div>
                    <label for="parallelism" class="block font-semibold">
                        Parallelism:
                    </label>
                    <input
                        type="number"
                        id="parallelism"
                        value="1"
                        min="1"
                        class="w-full px-4 py-2 border rounded-lg focus:outline-none fous:ring-2 focus:ring-purple-500"
                    />
                </div>
                <div>
                    <label for="salt" class="block font-semibold">
                        Salt:
                    </label>
                    <input
                        type="text"
                        id="salt"
                        value="randomSalt123"
                        class="w-full px-4 py-2 border rounded-lg focus:outline-none fous:ring-2 focus:ring-purple-500"
                    />
                </div>
            </div>
            <div>
                <label for="output" class="block font-semibold">
                    Hashed Output:
                </label>
                <textarea
                    id="output"
                    readonly
                    class="w-full px-4 py-2 border rounded-lg bg-gray-100 text-gray-700 focus:outline-none resize-none"
                    rows="3"
                    placeholder="Generated hash will appear here"></textarea>
            </div>
            <p id="feedback" class="text-sm text-red-600 mt-2 hidden"></p>
            <div class="flex justify-between items-center">
                <button
                    type="button"
                    id="generate"
                    class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 focus:ring-2 focus:ring-purple-500">
                    Generate Hash
                </button>
                <button
                    type="button"
                    id="copy"
                    class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 focus:ring-2 focus:ring-blue-500">
                    Copy to Clipboard
                </button>
                <button
                    type="button"
                    id="reset"
                    class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 focus:ring-2 focus:ring-gray-500">
                    Reset Form
                </button>
            </div>
        </form>
    </div>
</div>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/argon2-browser/1.18.0/argon2-bundled.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/zxcvbn/4.4.2/zxcvbn.js"></script>
<script is:inline>
    const passwordInput = document.getElementById('password');
    const strengthIndicator = document.getElementById('passwordStrength');
    const feedback = document.getElementById('feedback');
    const output = document.getElementById('output');

    document.getElementById('toggleVisibility').addEventListener('click', (e) => {
        if(passwordInput.type === 'password'){
            passwordInput.type = 'text';
            e.target.textContent = 'Hide';
        } else{
            passwordInput.type = 'password';
            e.target.textContent = 'Show';
        }
    });

    passwordInput.addEventListener('input', () => {
        const strength = zxcvbn(passwordInput.value);
        const strengthLevels = [
            'Very Weak', 'Weak', 'Fair', 'Strong', 'Very Strong'
        ];
        const colors = [
            'text-red-600', 'text-orange-600', 'text-yellow-500', 'text-green-600', 'text-green-700'
        ];
        strengthIndicator.textContent = `Strength: ${strengthLevels[strength.score]}`;
        strengthIndicator.className = `mt-2 text-sm ${colors[strength.score]}`;
    });
    document.getElementById('generate').addEventListener('click', async () => {
        feedback.classList.add('hidden');
        if(!passwordInput.value){
            feedback.textContent = 'Please enter a password';
            feedback.classList.remove('hidden');
            return;
        };
        const config = {
            pass: passwordInput.value,
            salt: document.getElementById('salt').value,
            time: parseInt(document.getElementById('iterations').value, 10),
            mem: parseInt(document.getElementById('memory').value, 10),
            parallelism: parseInt(document.getElementById('parallelism').value, 10),
            hashLen: 32,
            type: argon2.ArgonType.Argon2id,
        };

        try{
            const hash = await argon2.hash(config);
            output.value = hash.encoded;
        } catch (err){
            console.error(err);
            feedback.textContent = 'Error generationg hash';
            feedback.classList.remove('hidden');
        }
    });
    document.getElementById('copy').addEventListener('click', () => {
        output.select();
        document.execCommand('copy');
        feedback.textContent = 'Hash Copied to Clipboard!';
        feedback.classList.remove('hidden');
    });
    document.getElementById('reset').addEventListener('click', () => {
        document.getElementById('hashForm').reset();
        output.value = '';
        strengthIndicator.textContent = '';
        feedback.classList.add('hidden');
    })
</script>