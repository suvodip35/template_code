<div class="bg-gradient-to-br from-slate-950 via-violet-950 to-indigo-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-violet-200/50 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-200/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-slate-900/85 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl shadow-blue-950/60 border border-blue-500/30 relative z-10">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-violet-200/50 border border-violet-500/30 flex items-center justify-center text-violet-400 font-mono text-lg font-bold">64</div>
                <div>
                    <h2 class="text-xl font-bold text-slate-900 tracking-tight">Base64 Text Encoder</h2>
                    <p class="text-xs text-slate-500">Fast UTF-8 Base64 encoding &amp; decoding</p>
                </div>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-violet-50 text-violet-700 border border-violet-200 font-semibold">CRYPTO</span>
        </div>

        <!-- Mode Tabs -->
        <div class="bg-slate-50 p-1.5 rounded-2xl border border-slate-200 flex gap-1 mb-4">
            <button id="b64Encode" class="flex-1 py-2 text-xs font-semibold rounded-xl bg-violet-600 text-white shadow-md transition">Encode (Text ➔ Base64)</button>
            <button id="b64Decode" class="flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition">Decode (Base64 ➔ Text)</button>
        </div>

        <!-- Toggles -->
        <div class="flex items-center justify-between mb-4 text-xs text-slate-600 bg-slate-50 p-3 rounded-xl border border-slate-200">
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="chkUrlSafe" class="w-4 h-4 rounded accent-violet-600 cursor-pointer" />
                <span>URL-Safe Mode (RFC 4648)</span>
            </label>
            <span id="byteDiff" class="font-mono text-violet-400 font-semibold">+33% Size Ratio</span>
        </div>

        <!-- Input Box -->
        <div class="mb-4">
            <div class="flex items-center justify-between text-xs text-slate-500 mb-1.5">
                <span id="b64InputLabel" class="font-medium">Raw UTF-8 Text:</span>
                <span id="b64InStats" class="font-mono text-slate-400">28 bytes</span>
            </div>
            <textarea id="b64Input" rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs sm:text-sm text-slate-200 font-mono focus:outline-none focus:border-violet-500 resize-none">WebCraft & Devs: Pure Code 2026</textarea>
        </div>

        <!-- Output Box -->
        <div class="mb-5">
            <div class="flex items-center justify-between text-xs text-slate-500 mb-1.5">
                <span id="b64OutputLabel" class="font-medium">Base64 Encoded Result:</span>
                <span id="b64OutStats" class="font-mono text-emerald-400">40 chars</span>
            </div>
            <div id="b64Output" class="h-24 overflow-y-auto bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs sm:text-sm text-violet-300 font-mono break-all select-all leading-relaxed">
                V2ViQ3JhZnQgJiBEZXZzOiBQdXJlIENvZGUgMjAyNg==
            </div>
        </div>

        <!-- Action Row -->
        <div class="flex items-center gap-3">
            <button id="btnB64Action" class="flex-1 bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-700 hover:to-indigo-700 text-white font-semibold py-3 px-4 rounded-xl shadow-md shadow-violet-200 transition active:scale-[0.98] flex items-center justify-center gap-2 text-sm">
                <span>⚡ Run Encoder</span>
            </button>
            <button id="btnB64Copy" class="bg-slate-800 hover:bg-slate-700 text-white font-semibold py-3 px-5 rounded-xl border border-slate-200 transition active:scale-[0.98] flex items-center justify-center gap-2 text-sm">
                <span id="b64CopyIcon">📋</span>
                <span id="b64CopyText">Copy Base64</span>
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    let mode = 'encode';
    const input = document.getElementById('b64Input');
    const output = document.getElementById('b64Output');
    const btnEnc = document.getElementById('b64Encode');
    const btnDec = document.getElementById('b64Decode');
    const chkUrlSafe = document.getElementById('chkUrlSafe');
    const inStats = document.getElementById('b64InStats');
    const outStats = document.getElementById('b64OutStats');
    const btnAction = document.getElementById('btnB64Action');
    const btnCopy = document.getElementById('btnB64Copy');
    const copyText = document.getElementById('b64CopyText');

    function utf8_to_b64(str) {
        return window.btoa(unescape(encodeURIComponent(str)));
    }

    function b64_to_utf8(str) {
        return decodeURIComponent(escape(window.atob(str)));
    }

    function process() {
        const val = input.value;
        inStats.textContent = `${new Blob([val]).size} bytes`;

        if (mode === 'encode') {
            try {
                let res = utf8_to_b64(val);
                if (chkUrlSafe.checked) {
                    res = res.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
                }
                output.textContent = res;
                outStats.textContent = `${res.length} chars (Valid)`;
                outStats.className = "font-mono text-emerald-400";
            } catch (e) {
                output.textContent = 'Encoding error';
                outStats.textContent = 'Error';
                outStats.className = "font-mono text-rose-400";
            }
        } else {
            try {
                let clean = val.trim();
                if (chkUrlSafe.checked) {
                    clean = clean.replace(/-/g, '+').replace(/_/g, '/');
                    while (clean.length % 4) clean += '=';
                }
                const res = b64_to_utf8(clean);
                output.textContent = res;
                outStats.textContent = `${new Blob([res]).size} bytes (Decoded)`;
                outStats.className = "font-mono text-emerald-400";
            } catch (e) {
                output.textContent = 'Invalid Base64 string';
                outStats.textContent = 'Invalid Base64';
                outStats.className = "font-mono text-rose-400";
            }
        }
    }

    btnEnc.onclick = () => {
        mode = 'encode';
        btnEnc.className = "flex-1 py-2 text-xs font-semibold rounded-xl bg-violet-600 text-white shadow-md transition";
        btnDec.className = "flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition";
        btnAction.innerHTML = "<span>⚡ Run Encoder</span>";
        btnCopy.querySelector('span:last-child').textContent = "Copy Base64";
        process();
    };

    btnDec.onclick = () => {
        mode = 'decode';
        btnDec.className = "flex-1 py-2 text-xs font-semibold rounded-xl bg-violet-600 text-white shadow-md transition";
        btnEnc.className = "flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition";
        btnAction.innerHTML = "<span>⚡ Run Decoder</span>";
        btnCopy.querySelector('span:last-child').textContent = "Copy Text";
        process();
    };

    chkUrlSafe.onchange = process;
    input.oninput = process;
    btnAction.onclick = process;

    btnCopy.onclick = async () => {
        await navigator.clipboard.writeText(output.textContent);
        const orig = copyText.textContent;
        copyText.textContent = 'Copied! ✓';
        btnCopy.classList.add('bg-emerald-600', 'border-emerald-500');
        setTimeout(() => {
            copyText.textContent = orig;
            btnCopy.classList.remove('bg-emerald-600', 'border-emerald-500');
        }, 1400);
    };

    process();
})();
</script>