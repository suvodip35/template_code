<div class="bg-gradient-to-r from-blue-500 via-purple-500 to-indigo-500 min-h-screen text-white flex items-center justify-center p-6">
  <div class="max-w-lg w-full bg-white text-black rounded-2xl shadow-2xl p-6 my-10">
    <h1 class="text-center text-2xl font-bold mb-6 text-gray-800">Book Search Tool</h1>
    <div class="flex justify-between mb-4 gap-2">
      <input type="text" id="searchInput" placeholder="Search by title, author, or ISBN" class="w-full p-3 rounded-xl border border-gray-200 text-black shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
      <button id="searchButton" class="px-5 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-md font-semibold">Search</button>
    </div>
    <div id="loading" class="text-center text-indigo-500 hidden py-2">Loading...</div>
    <div id="result" class="grid grid-cols-3 gap-3"></div>
    <div id="pagination" class="flex justify-center mt-4 space-x-2"></div>
  </div>
</div>

<script is:inline>
  const apiUrl = 'https://openlibrary.org/search.json';
  const resultsContainer = document.getElementById('result');
  const searchButton = document.getElementById('searchButton');
  const searchInput = document.getElementById('searchInput');
  const loadingIndicator = document.getElementById('loading');

  let currentPage = 1;
  let currentQuery = '';

  const fetchBooks = async (query, page = 1) => {
    loadingIndicator.classList.remove('hidden');
    resultsContainer.innerHTML = '';
    try {
      const response = await fetch(`${apiUrl}?q=${query}&page=${page}`);
      const data = await response.json();
      displayResults(data.docs.slice(0, 6));
    } catch(err) {
      resultsContainer.innerHTML = '<p class="text-red-500 col-span-3 text-center">Error fetching books</p>';
    } finally {
      loadingIndicator.classList.add('hidden');
    }
  };

  function displayResults(books) {
    resultsContainer.innerHTML = '';
    books.forEach(b => {
      const card = document.createElement('div');
      card.className = 'p-2 bg-gray-50 rounded-lg shadow text-center cursor-pointer hover:bg-gray-100 transition';
      card.innerHTML = `<p class="font-bold text-xs truncate">${b.title}</p><p class="text-gray-500 text-[10px]">${b.author_name?.[0] || 'Unknown'}</p>`;
      resultsContainer.appendChild(card);
    });
  }

  searchButton.addEventListener('click', () => {
    const q = searchInput.value.trim();
    if (q) fetchBooks(q, 1);
  });
</script>