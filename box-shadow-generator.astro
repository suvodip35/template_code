<div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-slate-800/90 backdrop-blur-md p-6 rounded-2xl shadow-2xl border border-slate-700">
        <h2 class="text-2xl font-bold text-center mb-6 text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400">
            Box Shadow Generator
        </h2>

        <!-- Interactive Preview Box -->
        <div class="flex items-center justify-center h-44 bg-slate-900/60 rounded-xl mb-6 p-4 border border-slate-700/50">
            <div id="previewCard" class="w-28 h-28 bg-indigo-600 rounded-xl transition-all duration-150 flex items-center justify-center text-white text-xs font-semibold shadow-lg">
                Preview
            </div>
        </div>

        <!-- Controls -->
        <div class="space-y-3 text-sm text-slate-300 mb-6">
            <div class="flex justify-between items-center">
                <span>Offset X (<span id="valX" class="text-indigo-400 font-mono">10px</span>)</span>
                <input id="rangeX" type="range" min="-50" max="50" value="10" class="w-48 accent-indigo-500 cursor-pointer" />
            </div>
            <div class="flex justify-between items-center">
                <span>Offset Y (<span id="valY" class="text-indigo-400 font-mono">10px</span>)</span>
                <input id="rangeY" type="range" min="-50" max="50" value="10" class="w-48 accent-indigo-500 cursor-pointer" />
            </div>
            <div class="flex justify-between items-center">
                <span>Blur (<span id="valBlur" class="text-indigo-400 font-mono">20px</span>)</span>
                <input id="rangeBlur" type="range" min="0" max="100" value="20" class="w-48 accent-indigo-500 cursor-pointer" />
            </div>
            <div class="flex justify-between items-center">
                <span>Spread (<span id="valSpread" class="text-indigo-400 font-mono">0px</span>)</span>
                <input id="rangeSpread" type="range" min="-20" max="50" value="0" class="w-48 accent-indigo-500 cursor-pointer" />
            </div>
            <div class="flex justify-between items-center pt-1">
                <label class="flex items-center space-x-2 cursor-pointer">
                    <input id="checkInset" type="checkbox" class="rounded bg-slate-900 border-slate-600 text-indigo-500 focus:ring-0" />
                    <span>Inset Shadow</span>
                </label>
                <div class="flex items-center space-x-2">
                    <span class="text-xs">Color:</span>
                    <input id="shadowColor" type="color" value="#000000" class="w-8 h-8 rounded border-0 bg-transparent cursor-pointer" />
                </div>
            </div>
        </div>

        <!-- CSS Output & Copy Button -->
        <div class="relative">
            <pre class="bg-slate-950 p-3 rounded-lg text-xs font-mono text-indigo-300 overflow-x-auto border border-slate-700/60 mb-3"><code id="cssOutput">box-shadow: 10px 10px 20px 0px rgba(0, 0, 0, 0.4);</code></pre>
            <button id="copyCssBtn" class="w-full bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 text-white font-medium py-2.5 rounded-xl hover:opacity-95 transition shadow-lg flex items-center justify-center space-x-2">
                <span>Copy CSS Rule</span>
            </button>
        </div>
    </div>
</div>

<script is:inline>
    const rangeX = document.getElementById('rangeX');
    const rangeY = document.getElementById('rangeY');
    const rangeBlur = document.getElementById('rangeBlur');
    const rangeSpread = document.getElementById('rangeSpread');
    const checkInset = document.getElementById('checkInset');
    const shadowColor = document.getElementById('shadowColor');
    const previewCard = document.getElementById('previewCard');
    const valX = document.getElementById('valX');
    const valY = document.getElementById('valY');
    const valBlur = document.getElementById('valBlur');
    const valSpread = document.getElementById('valSpread');
    const cssOutput = document.getElementById('cssOutput');
    const copyCssBtn = document.getElementById('copyCssBtn');

    function hexToRgba(hex, alpha = 0.4) {
        const r = parseInt(hex.slice(1, 3), 16) || 0;
        const g = parseInt(hex.slice(3, 5), 16) || 0;
        const b = parseInt(hex.slice(5, 7), 16) || 0;
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function updateShadow() {
        const x = rangeX.value;
        const y = rangeY.value;
        const blur = rangeBlur.value;
        const spread = rangeSpread.value;
        const inset = checkInset.checked ? 'inset ' : '';
        const color = hexToRgba(shadowColor.value, 0.45);

        valX.textContent = `${x}px`;
        valY.textContent = `${y}px`;
        valBlur.textContent = `${blur}px`;
        valSpread.textContent = `${spread}px`;

        const shadowVal = `${inset}${x}px ${y}px ${blur}px ${spread}px ${color}`;
        previewCard.style.boxShadow = shadowVal;
        cssOutput.textContent = `box-shadow: ${shadowVal};`;
    }

    [rangeX, rangeY, rangeBlur, rangeSpread, checkInset, shadowColor].forEach(el => {
        el.addEventListener('input', updateShadow);
    });

    copyCssBtn.addEventListener('click', () => {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(cssOutput.textContent).catch(() => {});
            }
        } catch (e) {}
        copyCssBtn.innerHTML = '<span>Copied to Clipboard! ✓</span>';
        setTimeout(() => {
            copyCssBtn.innerHTML = '<span>Copy CSS Rule</span>';
        }, 1800);
    });

    updateShadow();
</script>
