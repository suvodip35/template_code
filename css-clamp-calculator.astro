<div class="bg-gradient-to-br from-slate-950 via-cyan-950 to-blue-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-cyan-200/50 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-500/25 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-slate-900/85 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl shadow-blue-950/60 border border-blue-500/30 relative z-10">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-cyan-200/50 border border-cyan-500/30 flex items-center justify-center text-cyan-400 font-mono text-lg font-bold">()</div>
                <div>
                    <h2 class="text-xl font-bold text-slate-900 tracking-tight">CSS Clamp() Calculator</h2>
                    <p class="text-xs text-slate-500">Generate fluid responsive typography with zero media queries</p>
                </div>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-cyan-50 text-cyan-700 border border-cyan-200 font-semibold">CSS &amp; DESIGN</span>
        </div>

        <!-- Presets Bar -->
        <div class="flex items-center gap-2 mb-5">
            <button id="presetHeading" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-cyan-600 text-white shadow-md transition">Hero Heading</button>
            <button id="presetSubheading" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 border border-slate-200 transition">Subheading</button>
            <button id="presetBody" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 border border-slate-200 transition">Body Text</button>
        </div>

        <!-- Inputs Grid -->
        <div class="grid grid-cols-2 gap-3 mb-5 text-xs text-slate-600">
            <!-- Min / Max Font -->
            <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 flex flex-col gap-2">
                <div class="flex items-center justify-between text-slate-400">
                    <span>Min Font Size:</span>
                    <span id="minFontLabel" class="font-mono text-cyan-400 font-bold">24px (1.5rem)</span>
                </div>
                <input id="minFontInput" type="range" min="12" max="48" value="24" class="accent-cyan-600 cursor-pointer" />
            </div>

            <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 flex flex-col gap-2">
                <div class="flex items-center justify-between text-slate-400">
                    <span>Max Font Size:</span>
                    <span id="maxFontLabel" class="font-mono text-cyan-400 font-bold">56px (3.5rem)</span>
                </div>
                <input id="maxFontInput" type="range" min="32" max="96" value="56" class="accent-cyan-600 cursor-pointer" />
            </div>

            <!-- Viewport Range -->
            <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 flex flex-col gap-2">
                <div class="flex items-center justify-between text-slate-400">
                    <span>Min Screen:</span>
                    <span id="minScreenLabel" class="font-mono text-slate-400 font-bold">360px</span>
                </div>
                <input id="minScreenInput" type="range" min="320" max="640" value="360" class="accent-cyan-600 cursor-pointer" />
            </div>

            <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 flex flex-col gap-2">
                <div class="flex items-center justify-between text-slate-400">
                    <span>Max Screen:</span>
                    <span id="maxScreenLabel" class="font-mono text-slate-400 font-bold">1280px</span>
                </div>
                <input id="maxScreenInput" type="range" min="960" max="1920" value="1280" class="accent-cyan-600 cursor-pointer" />
            </div>
        </div>

        <!-- Simulated Viewport Slider & Live Typography Preview Box -->
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 mb-5">
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
                <span>Simulated Viewport Width:</span>
                <span id="viewportLabel" class="font-mono text-cyan-400 font-bold">768px (Tablet)</span>
            </div>
            <input id="simViewportInput" type="range" min="320" max="1440" value="768" class="w-full accent-cyan-600 cursor-pointer mb-4" />

            <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 flex flex-col items-center justify-center min-h-[90px] text-center overflow-hidden">
                <div id="fluidSampleText" class="font-black text-white tracking-tight leading-none transition-all duration-75">Fluid Typography</div>
                <span id="computedSizeBadge" class="text-[11px] font-mono text-cyan-400 mt-2 font-semibold">Current size: 37.3px (2.33rem)</span>
            </div>
        </div>

        <!-- Result CSS Output -->
        <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 mb-5 flex items-center justify-between font-mono text-xs sm:text-sm text-cyan-700 overflow-x-auto select-all">
            <span id="clampCssResult">font-size: clamp(1.5rem, 0.72rem + 3.48vw, 3.5rem);</span>
        </div>

        <!-- Action Row -->
        <div class="flex items-center gap-3">
            <button id="btnDynAction" class="flex-1 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 text-slate-950 font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-cyan-500/25 transition active:scale-[0.98] flex items-center justify-center gap-2 text-sm">
                <span>⚡ Next Preset</span>
            </button>
            <button id="btnDynCopy" class="bg-slate-800 hover:bg-slate-700 text-white font-semibold py-3.5 px-5 rounded-xl border border-slate-200 transition active:scale-[0.98] flex items-center justify-center gap-2 text-sm">
                <span id="clampCopyText">Copy CSS</span>
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const minFontIn = document.getElementById('minFontInput');
    const maxFontIn = document.getElementById('maxFontInput');
    const minScreenIn = document.getElementById('minScreenInput');
    const maxScreenIn = document.getElementById('maxScreenInput');
    const simViewportIn = document.getElementById('simViewportInput');

    const minFontLbl = document.getElementById('minFontLabel');
    const maxFontLbl = document.getElementById('maxFontLabel');
    const minScreenLbl = document.getElementById('minScreenLabel');
    const maxScreenLbl = document.getElementById('maxScreenLabel');
    const viewportLbl = document.getElementById('viewportLabel');

    const sampleText = document.getElementById('fluidSampleText');
    const computedBadge = document.getElementById('computedSizeBadge');
    const clampResult = document.getElementById('clampCssResult');

    const btnPresetH = document.getElementById('presetHeading');
    const btnPresetS = document.getElementById('presetSubheading');
    const btnPresetB = document.getElementById('presetBody');
    const btnNext = document.getElementById('btnDynAction');
    const btnCopy = document.getElementById('btnDynCopy');
    const copyText = document.getElementById('clampCopyText');

    let currentPresetIdx = 0;
    const PRESETS = [
        { name: 'Hero Heading', minF: 24, maxF: 56, minS: 360, maxS: 1280 },
        { name: 'Subheading',   minF: 18, maxF: 32, minS: 360, maxS: 1200 },
        { name: 'Body Text',    minF: 14, maxF: 18, minS: 320, maxS: 1024 }
    ];

    function calculate() {
        const minF = parseFloat(minFontIn.value);
        const maxF = parseFloat(maxFontIn.value);
        const minS = parseFloat(minScreenIn.value);
        const maxS = parseFloat(maxScreenIn.value);
        const vp = parseFloat(simViewportIn.value);

        minFontLbl.textContent = `${minF}px (${(minF / 16).toFixed(2)}rem)`;
        maxFontLbl.textContent = `${maxF}px (${(maxF / 16).toFixed(2)}rem)`;
        minScreenLbl.textContent = `${minS}px`;
        maxScreenLbl.textContent = `${maxS}px`;

        let vpType = vp < 640 ? 'Mobile' : (vp < 1024 ? 'Tablet' : 'Desktop');
        viewportLbl.textContent = `${vp}px (${vpType})`;

        // Clamp math
        const minRem = (minF / 16).toFixed(2);
        const maxRem = (maxF / 16).toFixed(2);
        const slope = (maxF - minF) / (maxS - minS);
        const yIntersection = (-minS * slope + minF) / 16;
        const slopeVw = (slope * 100).toFixed(2);
        const yRem = yIntersection.toFixed(2);

        const css = `font-size: clamp(${minRem}rem, ${yRem}rem + ${slopeVw}vw, ${maxRem}rem);`;
        clampResult.textContent = css;

        // Current simulated size
        let curPx;
        if (vp <= minS) curPx = minF;
        else if (vp >= maxS) curPx = maxF;
        else curPx = minF + (vp - minS) * slope;

        sampleText.style.fontSize = `${curPx}px`;
        computedBadge.textContent = `Current size: ${curPx.toFixed(1)}px (${(curPx / 16).toFixed(2)}rem)`;
    }

    function applyPreset(p) {
        minFontIn.value = p.minF;
        maxFontIn.value = p.maxF;
        minScreenIn.value = p.minS;
        maxScreenIn.value = p.maxS;
        calculate();
    }

    btnPresetH.onclick = () => { applyPreset(PRESETS[0]); updateTabs(btnPresetH); };
    btnPresetS.onclick = () => { applyPreset(PRESETS[1]); updateTabs(btnPresetS); };
    btnPresetB.onclick = () => { applyPreset(PRESETS[2]); updateTabs(btnPresetB); };

    function updateTabs(activeBtn) {
        [btnPresetH, btnPresetS, btnPresetB].forEach(b => {
            b.className = b === activeBtn
                ? "preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-cyan-600 text-white shadow-md transition"
                : "preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 border border-slate-200 transition";
        });
    }

    btnNext.onclick = () => {
        currentPresetIdx = (currentPresetIdx + 1) % PRESETS.length;
        applyPreset(PRESETS[currentPresetIdx]);
        const btns = [btnPresetH, btnPresetS, btnPresetB];
        updateTabs(btns[currentPresetIdx]);
    };

    [minFontIn, maxFontIn, minScreenIn, maxScreenIn, simViewportIn].forEach(input => {
        input.addEventListener('input', calculate);
    });

    btnCopy.onclick = async () => {
        await navigator.clipboard.writeText(clampResult.textContent);
        copyText.textContent = 'Copied! ✓';
        btnCopy.classList.add('bg-emerald-600', 'border-emerald-500');
        setTimeout(() => {
            copyText.textContent = 'Copy CSS';
            btnCopy.classList.remove('bg-emerald-600', 'border-emerald-500');
        }, 1400);
    };

    calculate();
})();
</script>