<div class="bg-gradient-to-br from-slate-950 via-blue-950 to-indigo-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-indigo-200/50 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-fuchsia-200/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-slate-900/85 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl shadow-blue-950/60 border border-blue-500/30 relative z-10">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-200/50 border border-indigo-500/30 flex items-center justify-center text-indigo-400 font-mono text-lg font-bold">∿</div>
                <div>
                    <h2 class="text-xl font-bold text-slate-900 tracking-tight">CSS Cubic Bezier Generator</h2>
                    <p class="text-xs text-slate-500">Craft custom timing functions &amp; animation easing</p>
                </div>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 font-semibold">CSS ANIMATION</span>
        </div>

        <!-- Presets -->
        <div class="flex items-center gap-2 mb-4">
            <button id="pBounce" class="bezier-preset px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow-md transition">Elastic Bounce</button>
            <button id="pSnappy" class="bezier-preset px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 border border-slate-200 transition">Snappy Out</button>
            <button id="pSmooth" class="bezier-preset px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 border border-slate-200 transition">Smooth Ease</button>
        </div>

        <!-- Visual Curve SVG Display Box -->
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 mb-4 flex items-center justify-center relative">
            <svg id="bezierSvg" class="w-full h-36" viewBox="0 0 300 120">
                <line x1="30" y1="100" x2="270" y2="100" stroke="#334155" stroke-width="1" stroke-dasharray="3,3" />
                <line x1="30" y1="20" x2="270" y2="20" stroke="#334155" stroke-width="1" stroke-dasharray="3,3" />
                <line x1="30" y1="100" x2="270" y2="20" stroke="#1e293b" stroke-width="1.5" />
                <path id="bezierCurvePath" d="M 30 100 C 120 -20, 200 130, 270 20" fill="none" stroke="#6366f1" stroke-width="3" stroke-linecap="round" />
                <line id="handle1" x1="30" y1="100" x2="120" y2="-20" stroke="#818cf8" stroke-width="1" stroke-dasharray="2,2" />
                <line id="handle2" x1="270" y1="20" x2="200" y2="130" stroke="#f472b6" stroke-width="1" stroke-dasharray="2,2" />
                <circle id="cp1" cx="120" cy="-20" r="5" fill="#818cf8" />
                <circle id="cp2" cx="200" cy="130" r="5" fill="#f472b6" />
                <circle cx="30" cy="100" r="4" fill="#94a3b8" />
                <circle cx="270" cy="20" r="4" fill="#94a3b8" />
            </svg>
        </div>

        <!-- Animation Race Track Comparison -->
        <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 mb-4 space-y-2.5">
            <div>
                <div class="flex justify-between text-[11px] text-slate-400 mb-1">
                    <span class="text-indigo-400 font-semibold">Custom Bezier Track:</span>
                    <span id="metricTime">Duration: 750ms</span>
                </div>
                <div class="h-6 bg-slate-900 rounded-lg p-1 relative overflow-hidden">
                    <div id="animBallCustom" class="w-4 h-4 rounded-full bg-gradient-to-r from-indigo-500 to-fuchsia-500 shadow-md shadow-indigo-500/50 absolute left-1 top-1"></div>
                </div>
            </div>
            <div>
                <div class="flex justify-between text-[11px] text-slate-400 mb-1">
                    <span class="text-slate-500">Linear Reference:</span>
                    <span class="text-slate-600">Standard</span>
                </div>
                <div class="h-6 bg-slate-900 rounded-lg p-1 relative overflow-hidden">
                    <div id="animBallLinear" class="w-4 h-4 rounded-full bg-slate-600 absolute left-1 top-1"></div>
                </div>
            </div>
        </div>

        <!-- CSS Output Box -->
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 mb-5 flex items-center justify-between font-mono text-xs sm:text-sm text-indigo-700 overflow-x-auto select-all">
            <span id="bezierCssResult">transition-timing-function: cubic-bezier(0.68, -0.55, 0.27, 1.55);</span>
        </div>

        <!-- Action Row -->
        <div class="flex items-center gap-3">
            <button id="btnDynAction" class="flex-1 bg-gradient-to-r from-indigo-500 to-fuchsia-600 hover:from-indigo-600 hover:to-fuchsia-700 text-white font-semibold py-3.5 px-4 rounded-xl shadow-lg shadow-indigo-500/25 transition active:scale-[0.98] flex items-center justify-center gap-2 text-sm">
                <span>⚡ Play Transition</span>
            </button>
            <button id="btnDynCopy" class="bg-slate-800 hover:bg-slate-700 text-white font-semibold py-3.5 px-5 rounded-xl border border-slate-200 transition active:scale-[0.98] text-sm">
                <span id="copyBezierText">Copy CSS</span>
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    let p1x = 0.68, p1y = -0.55, p2x = 0.27, p2y = 1.55;

    const ballCustom = document.getElementById('animBallCustom');
    const ballLinear = document.getElementById('animBallLinear');
    const pathEl = document.getElementById('bezierCurvePath');
    const h1 = document.getElementById('handle1');
    const h2 = document.getElementById('handle2');
    const cp1 = document.getElementById('cp1');
    const cp2 = document.getElementById('cp2');
    const cssResult = document.getElementById('bezierCssResult');

    const btnBounce = document.getElementById('pBounce');
    const btnSnappy = document.getElementById('pSnappy');
    const btnSmooth = document.getElementById('pSmooth');
    const btnPlay = document.getElementById('btnDynAction');
    const btnCopy = document.getElementById('btnDynCopy');
    const copyText = document.getElementById('copyBezierText');

    function update() {
        const x1 = 30 + p1x * 240;
        const y1 = 100 - p1y * 80;
        const x2 = 30 + p2x * 240;
        const y2 = 100 - p2y * 80;

        pathEl.setAttribute('d', `M 30 100 C ${x1} ${y1}, ${x2} ${y2}, 270 20`);
        h1.setAttribute('x2', x1); h1.setAttribute('y2', y1);
        h2.setAttribute('x2', x2); h2.setAttribute('y2', y2);
        cp1.setAttribute('cx', x1); cp1.setAttribute('cy', y1);
        cp2.setAttribute('cx', x2); cp2.setAttribute('cy', y2);

        const timing = `cubic-bezier(${p1x}, ${p1y}, ${p2x}, ${p2y})`;
        cssResult.textContent = `transition-timing-function: ${timing};`;
        ballCustom.style.transition = `left 750ms ${timing}`;
        ballLinear.style.transition = `left 750ms linear`;
    }

    function play() {
        ballCustom.style.left = '4px';
        ballLinear.style.left = '4px';
        setTimeout(() => {
            ballCustom.style.left = 'calc(100% - 20px)';
            ballLinear.style.left = 'calc(100% - 20px)';
        }, 50);
        setTimeout(() => {
            ballCustom.style.left = '4px';
            ballLinear.style.left = '4px';
        }, 1200);
    }

    function setPreset(x1, y1, x2, y2, activeBtn) {
        p1x = x1; p1y = y1; p2x = x2; p2y = y2;
        [btnBounce, btnSnappy, btnSmooth].forEach(b => {
            b.className = b === activeBtn
                ? "bezier-preset px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow-md transition"
                : "bezier-preset px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 border border-slate-200 transition";
        });
        update();
        play();
    }

    btnBounce.onclick = () => setPreset(0.68, -0.55, 0.27, 1.55, btnBounce);
    btnSnappy.onclick = () => setPreset(0.2, 0.8, 0.2, 1, btnSnappy);
    btnSmooth.onclick = () => setPreset(0.42, 0, 0.58, 1, btnSmooth);

    btnPlay.onclick = play;

    btnCopy.onclick = async () => {
        await navigator.clipboard.writeText(cssResult.textContent);
        copyText.textContent = 'Copied! ✓';
        btnCopy.classList.add('bg-emerald-600', 'border-emerald-500');
        setTimeout(() => {
            copyText.textContent = 'Copy CSS';
            btnCopy.classList.remove('bg-emerald-600', 'border-emerald-500');
        }, 1400);
    };

    update();
    setTimeout(play, 300);
})();
</script>