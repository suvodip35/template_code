<div class="bg-gradient-to-br from-slate-950 via-teal-950 to-emerald-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-teal-600/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-emerald-600/25 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-slate-900/90 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl shadow-teal-950/70 border border-teal-500/35 relative z-10 transition-all duration-300">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-800/80 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-teal-950/80 border border-teal-500/40 flex items-center justify-center text-teal-400 font-mono text-xl font-bold shadow-sm">API</div>
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-300 tracking-tight">cURL to Fetch Converter</h2>
                    <p class="text-xs text-slate-400 font-medium">Convert raw cURL requests to async/await fetch() &amp; Axios</p>
                </div>
            </div>
            <span id="curlStatus" class="text-xs font-mono px-3 py-1 rounded-full bg-teal-950/80 text-teal-300 border border-teal-500/40 font-semibold shadow-sm">cURL DETECTED ✓</span>
        </div>

        <!-- Mode Tabs -->
        <div class="bg-slate-950/60 p-1.5 rounded-2xl border border-slate-800 flex gap-1 mb-4 text-xs font-semibold">
            <button id="tabFetch" class="flex-1 py-2 rounded-xl bg-teal-600 text-white shadow-md transition flex items-center justify-center gap-1.5">
                <span>⚡ fetch() (async/await)</span>
            </button>
            <button id="tabAxios" class="flex-1 py-2 rounded-xl text-slate-400 hover:text-white transition flex items-center justify-center gap-1.5">
                <span>📦 axios.post()</span>
            </button>
        </div>

        <!-- Raw cURL Input -->
        <div class="mb-4">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2">
                <span>Input cURL Command:</span>
                <span id="curlStats" class="font-mono text-teal-400 font-bold bg-teal-950/60 px-2.5 py-0.5 rounded-md border border-teal-800/60">POST /v1/users</span>
            </div>
            <textarea id="curlInput" rows="3" class="w-full bg-slate-950/80 border border-slate-800 rounded-2xl p-3 text-xs sm:text-sm font-mono text-slate-200 focus:outline-none focus:border-teal-500 transition resize-none leading-relaxed select-text">curl -X POST https://api.webcraft.io/v1/users \
  -H "Authorization: Bearer dev_token_982" \
  -H "Content-Type: application/json" \
  -d '{"name": "Alice Smith", "role": "lead_developer", "active": true}'</textarea>
        </div>

        <!-- Generated JS Code Output -->
        <div class="mb-5">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2">
                <span id="outputLabel">Generated Modern JavaScript:</span>
                <span id="jsStats" class="font-mono text-emerald-400 font-bold bg-emerald-950/60 px-2.5 py-0.5 rounded-md border border-emerald-800/60">Async / Await ✓</span>
            </div>
            <textarea id="curlOutput" rows="7" readonly class="w-full bg-slate-950/95 border border-teal-900/50 rounded-2xl p-3 text-xs sm:text-sm font-mono text-emerald-300 focus:outline-none resize-none leading-relaxed select-text shadow-inner"></textarea>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button id="btnConvertCurl" class="flex-1 bg-gradient-to-r from-teal-600 to-emerald-600 hover:from-teal-500 hover:to-emerald-500 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-teal-950/40 transition active:scale-[0.98] text-sm flex items-center justify-center gap-2">
                <span>⚡ Convert to JavaScript</span>
            </button>
            <button id="btnCopyJS" class="bg-slate-800/90 hover:bg-slate-700 text-white font-bold py-3.5 px-5 rounded-xl border border-slate-700 transition active:scale-[0.98] text-sm">
                Copy Code
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const input = document.getElementById('curlInput');
    const output = document.getElementById('curlOutput');
    const tabFetch = document.getElementById('tabFetch');
    const tabAxios = document.getElementById('tabAxios');
    const btnConvert = document.getElementById('btnConvertCurl');
    const btnCopy = document.getElementById('btnCopyJS');
    const jsStats = document.getElementById('jsStats');

    let mode = 'fetch';

    function parseCurl() {
        const raw = input.value.trim();
        let url = 'https://api.webcraft.io/v1/users';
        let method = 'POST';
        let headers = {};
        let body = null;

        const urlMatch = raw.match(/https?:\/\/[^\s"'\\]+/);
        if (urlMatch) url = urlMatch[0];

        const methodMatch = raw.match(/-X\s+([A-Z]+)/i);
        if (methodMatch) method = methodMatch[1].toUpperCase();

        const headerMatches = raw.matchAll(/-H\s+['"]([^'"]+)['"]/g);
        for (const m of headerMatches) {
            const parts = m[1].split(':');
            if (parts.length >= 2) {
                headers[parts[0].trim()] = parts.slice(1).join(':').trim();
            }
        }

        const dataMatch = raw.match(/(-d|--data|--data-raw)\s+['"](.*?)['"]/s);
        if (dataMatch) {
            body = dataMatch[2];
        }

        if (mode === 'fetch') {
            let code = `const response = await fetch('${url}', {\n`;
            code += `  method: '${method}',\n`;
            if (Object.keys(headers).length > 0) {
                code += `  headers: {\n`;
                for (const [k, v] of Object.entries(headers)) {
                    code += `    '${k}': '${v}',\n`;
                }
                code += `  },\n`;
            }
            if (body) {
                try {
                    const parsed = JSON.parse(body);
                    code += `  body: JSON.stringify(${JSON.stringify(parsed, null, 2).replace(/\n/g, '\n  ')})\n`;
                } catch(e) {
                    code += `  body: '${body}'\n`;
                }
            }
            code += `});\n\nconst data = await response.json();\nconsole.log(data);`;
            output.value = code;
            jsStats.textContent = 'fetch() async/await ✓';
        } else {
            let code = `import axios from 'axios';\n\n`;
            code += `const { data } = await axios({\n`;
            code += `  method: '${method.toLowerCase()}',\n`;
            code += `  url: '${url}',\n`;
            if (Object.keys(headers).length > 0) {
                code += `  headers: {\n`;
                for (const [k, v] of Object.entries(headers)) {
                    code += `    '${k}': '${v}',\n`;
                }
                code += `  },\n`;
            }
            if (body) {
                try {
                    const parsed = JSON.parse(body);
                    code += `  data: ${JSON.stringify(parsed, null, 2).replace(/\n/g, '\n  ')}\n`;
                } catch(e) {
                    code += `  data: '${body}'\n`;
                }
            }
            code += `});\n\nconsole.log(data);`;
            output.value = code;
            jsStats.textContent = 'axios client ✓';
        }
    }

    tabFetch.onclick = () => {
        mode = 'fetch';
        tabFetch.className = "flex-1 py-2 rounded-xl bg-teal-600 text-white shadow-md transition flex items-center justify-center gap-1.5";
        tabAxios.className = "flex-1 py-2 rounded-xl text-slate-400 hover:text-white transition flex items-center justify-center gap-1.5";
        parseCurl();
    };

    tabAxios.onclick = () => {
        mode = 'axios';
        tabAxios.className = "flex-1 py-2 rounded-xl bg-teal-600 text-white shadow-md transition flex items-center justify-center gap-1.5";
        tabFetch.className = "flex-1 py-2 rounded-xl text-slate-400 hover:text-white transition flex items-center justify-center gap-1.5";
        parseCurl();
    };

    btnConvert.onclick = () => {
        parseCurl();
        btnConvert.classList.add('scale-[0.98]');
        setTimeout(() => btnConvert.classList.remove('scale-[0.98]'), 150);
    };

    btnCopy.onclick = async () => {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(output.value);
            }
        } catch (e) {}
        btnCopy.textContent = 'Copied! ✓';
        btnCopy.classList.add('bg-emerald-600');
        setTimeout(() => {
            btnCopy.textContent = 'Copy Code';
            btnCopy.classList.remove('bg-emerald-600');
        }, 1400);
    };

    input.addEventListener('input', parseCurl);
    parseCurl();
})();
</script>