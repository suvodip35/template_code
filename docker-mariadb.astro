<div class="bg-slate-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden">
    <!-- Ambient Docker Cyan & MariaDB Blue glow -->
    <div class="absolute -top-24 -left-24 w-88 h-88 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-lg bg-slate-900/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-slate-800 relative z-10 overflow-hidden flex flex-col">
        <!-- Header Bar -->
        <div class="h-11 bg-slate-950/90 border-b border-slate-800 px-4 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            </div>
            <div class="flex items-center space-x-2 text-xs font-mono font-semibold text-slate-300">
                <span class="text-cyan-400">🐳 Docker</span>
                <span class="text-slate-600">•</span>
                <span class="text-blue-400">🦭 MariaDB Deployer</span>
            </div>
            <div class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 flex items-center space-x-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Ready</span>
            </div>
        </div>

        <!-- Live Container Status Simulation Card -->
        <div class="p-4 bg-slate-900/60 border-b border-slate-800 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-white text-lg shadow-lg shadow-cyan-500/20">
                    🦭
                </div>
                <div>
                    <h3 class="text-sm font-bold text-white flex items-center space-x-1.5">
                        <span id="labelContainerName">mariadb-server</span>
                        <span class="text-[10px] bg-slate-800 text-cyan-400 px-1.5 py-0.5 rounded font-mono font-normal">latest</span>
                    </h3>
                    <p class="text-xs text-slate-400 font-mono">Port: <span id="labelPort" class="text-emerald-400">3306</span> | Volume: <span id="labelVol" class="text-indigo-400">mariadb_data</span></p>
                </div>
            </div>
            <div class="text-right">
                <span class="text-xs font-mono font-semibold text-emerald-400 block">● UP 14m</span>
                <span class="text-[11px] text-slate-500 font-mono">127.0.0.1:3306</span>
            </div>
        </div>

        <!-- Interactive Configurator Form -->
        <div class="p-4 space-y-3 text-xs font-mono text-slate-300 border-b border-slate-800 bg-slate-950/40">
            <div class="flex justify-between items-center">
                <span class="text-slate-400">Root Password:</span>
                <input id="inputRootPass" type="text" value="secret123" class="w-48 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1 text-cyan-400 text-xs outline-none focus:border-cyan-500 transition" />
            </div>
            <div class="flex justify-between items-center">
                <span class="text-slate-400">Database Name:</span>
                <input id="inputDbName" type="text" value="webcraft_db" class="w-48 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1 text-cyan-400 text-xs outline-none focus:border-cyan-500 transition" />
            </div>
            <div class="flex justify-between items-center">
                <span class="text-slate-400">Host Port:</span>
                <input id="rangePort" type="number" min="1024" max="65535" value="3306" class="w-48 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1 text-cyan-400 text-xs outline-none focus:border-cyan-500 transition" />
            </div>
        </div>

        <!-- CLI Output Tabs & Code Block -->
        <div class="p-4 bg-slate-950/80">
            <div class="flex items-center justify-between mb-2">
                <div class="flex space-x-2">
                    <button id="tabCli" class="text-xs font-mono px-2.5 py-1 rounded bg-slate-800 text-cyan-400 font-semibold border border-slate-700 transition">docker run</button>
                    <button id="tabCompose" class="text-xs font-mono px-2.5 py-1 rounded text-slate-400 hover:text-white transition">docker-compose.yml</button>
                </div>
                <span class="text-[11px] text-slate-500 font-mono">One-Command Deploy</span>
            </div>

            <pre class="bg-slate-950 p-3 rounded-xl text-[11px] font-mono text-slate-300 overflow-x-auto border border-slate-800 mb-3 leading-relaxed"><code id="commandOutput">docker run -d \
  --name mariadb-server \
  -p 3306:3306 \
  -e MYSQL_ROOT_PASSWORD=secret123 \
  -e MYSQL_DATABASE=webcraft_db \
  -v mariadb_data:/var/lib/mysql \
  --restart unless-stopped \
  mariadb:latest</code></pre>

            <button id="copyDockerBtn" class="w-full bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 hover:from-cyan-600 hover:to-indigo-700 active:scale-[0.98] text-white font-semibold py-2.5 rounded-xl transition shadow-lg shadow-cyan-500/25 flex items-center justify-center space-x-2 text-xs font-mono">
                <span>Copy Docker Command</span>
            </button>
        </div>
    </div>
</div>

<script is:inline>
    const inputPass = document.getElementById('inputRootPass');
    const inputDb = document.getElementById('inputDbName');
    const rangePort = document.getElementById('rangePort');
    const valPortText = document.getElementById('valPortText');
    const labelPort = document.getElementById('labelPort');
    const commandOutput = document.getElementById('commandOutput');
    const copyBtn = document.getElementById('copyDockerBtn');
    const tabCli = document.getElementById('tabCli');
    const tabCompose = document.getElementById('tabCompose');

    let currentMode = 'cli';

    function updateDeployScript() {
        const pass = inputPass.value.trim() || 'secret123';
        const db = inputDb.value.trim() || 'webcraft_db';
        const port = rangePort.value;

        valPortText.textContent = port;
        labelPort.textContent = port;

        if (currentMode === 'cli') {
            commandOutput.textContent = `docker run -d \\\n  --name mariadb-server \\\n  -p ${port}:3306 \\\n  -e MYSQL_ROOT_PASSWORD=${pass} \\\n  -e MYSQL_DATABASE=${db} \\\n  -v mariadb_data:/var/lib/mysql \\\n  --restart unless-stopped \\\n  mariadb:latest`;
        } else {
            commandOutput.textContent = `services:\n  mariadb:\n    image: mariadb:latest\n    container_name: mariadb-server\n    restart: unless-stopped\n    ports:\n      - "${port}:3306"\n    environment:\n      MYSQL_ROOT_PASSWORD: ${pass}\n      MYSQL_DATABASE: ${db}\n    volumes:\n      - mariadb_data:/var/lib/mysql\n\nvolumes:\n  mariadb_data:`;
        }
    }

    [inputPass, inputDb, rangePort].forEach(el => {
        el.addEventListener('input', updateDeployScript);
    });

    tabCli.addEventListener('click', () => {
        currentMode = 'cli';
        tabCli.className = 'text-xs font-mono px-2.5 py-1 rounded bg-slate-800 text-cyan-400 font-semibold border border-slate-700 transition';
        tabCompose.className = 'text-xs font-mono px-2.5 py-1 rounded text-slate-400 hover:text-white transition';
        copyBtn.innerHTML = '<span>Copy Docker Command</span>';
        updateDeployScript();
    });

    tabCompose.addEventListener('click', () => {
        currentMode = 'compose';
        tabCompose.className = 'text-xs font-mono px-2.5 py-1 rounded bg-slate-800 text-cyan-400 font-semibold border border-slate-700 transition';
        tabCli.className = 'text-xs font-mono px-2.5 py-1 rounded text-slate-400 hover:text-white transition';
        copyBtn.innerHTML = '<span>Copy docker-compose.yml</span>';
        updateDeployScript();
    });

    copyBtn.addEventListener('click', async () => {
        try {
            await navigator.clipboard.writeText(commandOutput.textContent);
            const orig = copyBtn.innerHTML;
            copyBtn.innerHTML = '<span>Copied to Clipboard! ✓</span>';
            copyBtn.classList.add('bg-emerald-600');
            setTimeout(() => {
                copyBtn.innerHTML = orig;
                copyBtn.classList.remove('bg-emerald-600');
            }, 1800);
        } catch (e) {
            copyBtn.textContent = 'Copied! ✓';
        }
    });

    updateDeployScript();
</script>
