<div class="bg-gradient-to-r from-purple-500 via-pink-500 to-red-500 min-h-screen flex flex-col">
    <div class="text-center py-5 sticky top-0 bg-gradient-to-r from-purple-500 via-pink-500 to-red-500 z-10">
        <h1 class="text-4xl font-bold text-white">
            Trending GIFs Explorer
        </h1>
        <p class="text-white mt-2">
            Explore trending GIFs and search for your favorites!
        </p>
    </div>
    <div class="bg-white w-full max-w-lg mx-auto p-4 rounded-lg shadow-lg h-[700px] overflow-auto">
        <div class="flex justify-center mb-4">
            <input
                type="text"
                id="searchInput"
                placeholder="Search for GIFs..."
                class="w-full px-4 py-2 roundedl-md focus:outline-none border border-gray-300 shadow-sm"
            />
            <button
                id="searchBtn"
                class="bg-blue-600 text-white px-4 py-2 rounded-r-md hover:bg-blue-700 shadow-sm">
                Search
            </button>
        </div>
        <div id="copyMessage" class="text-green-500 text-center hidden"></div>
        <div id="gifContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
        <div class="text-center mt-6">
            <button
                id="loadMoreBtn"
                class="bg-green-500 text-white px-6 py-2 rounded-md hover:bg-green-600 shadow-sm hidden">
                Load More
            </button>
        </div>
    </div>
    <div id="gifModal" class="fixed inset-0 bg-black bg-opacity-75 hidden flex items-center justify-center z-20">
        <div class="relative bg-white p-4 rounded-lg shadow-lg">
            <button id="closeModal" class="absolute top-2 right-2 text-black text-xl font-bold">&times;</button>
            <img id="modalGif" class="max-w-full h-auto rounded-lg" src="" alt="Selected GIF">
        </div>
    </div>
</div>
<script is:inline>
    const apiKey = '6nHdaLBxS85tzoOMtesoyQyYzXTh4cQE';
    const gifContainer = document.getElementById('gifContainer');
    const searchInput = document.getElementById('searchInput');
    const searchBtn = document.getElementById('searchBtn');
    const loadMoreBtn = document.getElementById('loadMoreBtn');
    const copyMessage = document.getElementById('copyMessage');
    const gifModal = document.getElementById('gifModal');
    const modalGif = document.getElementById('modalGif');
    const closeModal = document.getElementById('closeModal');

    let offset = 0;
    let currentQuery = '';

    async function fetchGIFs(query = '', loadMore = false){
        if(!loadMore){
            gifContainer.innerHTML = '';
            offset = 0;
        }

        const endpoint = query
            ? `https://api.giphy.com/v1/gifs/search?api_key=${apiKey}&q=${query}&limit=12&offset${offset}`
            : `https://api.giphy.com/v1/gifs/trending?api_key=${apiKey}&limit=12&offese=${offset}`;

            const response = await fetch(endpoint);
            const { data } = await response.json();

            if(data.length){
                renderGIFs(data);
                loadMoreBtn.classList.remove('hidden');
            } else if(!loadMore){
                gifContainer.innerHTML = '<p class="text-gray-600 text-center">No result found.</p>';
                loadMoreBtn.classList.add('hidden');
            }
    };

    function renderGIFs(gifs){
        gifs.forEach((gif) => {
            const gifCard = document.createElement('div');
            gifCard.classList.add('relative', 'rounded-lg', 'overflow-hidden', 'shadow-md', 'hover:scale-105', 'transition-transform');

            const img = document.createElement('img');
            img.src = gif.images.fixed_height.url;
            img.alt = gif.title;
            img.classList.add('w-full', 'h-auto', 'cursor-pointer');
            img.addEventListener('click', () => showGifInModal(gif.images.fixed_height.url));

            const copyButton = document.createElement('button');
            copyButton.classList.add('absolute', 'bottom-2', 'left-2', 'bg-black', 'bg-opacity-50', 'text-white', 'text-sm', 'px-2', 'py-1', 'rounded-md');
            copyButton.textContent = 'Copy Link';
            copyButton.addEventListener('click', (e) => {
                e.stopPropagation();
                copyToClipboard(gif.images.fixed_height.url);
            });

            gifCard.appendChild(img);
            gifCard.appendChild(copyButton);
            gifContainer.appendChild(gifCard);
        })
    }

    function copyToClipboard(text){
        navigator.clipboard.writeText(text);
        copyMessage.textContent = 'GIF URL copied to clipboard!';
        copyMessage.classList.remove('hidden');
        setTimeout(() => {
            copyMessage.classList.add('hidden');
        }, 2000)
    }

    function showGifInModal(gifUrl){
        modalGif.src = gifUrl;
        gifModal.classList.remove('hidden');
    }

    closeModal.addEventListener('click', () => {
        gifModal.classList.add('hidden');
        modalGif.src = '';
    });

    searchBtn.addEventListener('click', () => {
        currentQuery = searchInput.value.trim();
        fetchGIFs(currentQuery);
    });

    loadMoreBtn.addEventListener('click', () => {
        offset += 12;
        fetchGIFs(currentQuery, true);
    });

    fetchGIFs();
</script>