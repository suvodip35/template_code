<div class="bg-gradient-to-br from-purple-500 via-teal-500 to-indigo-500 text-gray-800 min-h-screen flex items-center justify-center">
    <div class="w-full max-w-lg p-6 bg-white rounded-lg shadow-lg">
        <h1 class="text-2xl font-bold text-center text-indigo-600 mb-4">
            GitHub Repository Search
        </h1>
        <div class="flex gap-2">
            <input 
                type="text"
                id="searchInput"
                placeholder="Enter keywords (e.g., JavaScript, React)"
                class="flex-grow p-2 text-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-400" 
            />
            <button
                id="searchButton"
                class="px-4 py-2 bg-indigo-500 hover:bg-indigo-600 text-white rounded-md transition">
                Search
            </button>
        </div>
        <div class="mt-4 flex justify-between items-center">
            <button
                id="sortButton"
                class="px-3 py-1 text-sm bg-green-500 hover:bg-green-600 text-white rounded-md hidden">
                Sort by Stars
            </button>
            <span id="notification" class="text-sm text-gray-600"></span>
        </div>
        <div id="resultContainer" class="mt-6 space-y-4 overflow-y-auto bg-gray-50 border border-gray-200 rounded-lg p-4"></div>
    </div>
</div>
<script is:inline>

    const searchInput = document.getElementById('searchInput');
    const searchButton = document.getElementById('searchButton');
    const sortButton = document.getElementById('sortButton');
    const resultContainer = document.getElementById('resultContainer');
    const notification = document.getElementById('notification');

    let repositories = [];

    async function fetchRepositories(query) {
        const url = `https://api.github.com/search/repositories?q=${encodeURIComponent(query)}`;
        const response = await fetch(url);
        if(!response.ok){
            return[];
        }
        const data = await response.json();
        return data.items || []
    };

    function createRepoCard (repo){
        const {name, html_url, description, owner, clone_url, stargazers_count} = repo;
        return `
            <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm">
                <h2 class="text-lg font-semibold text-blue-500">
                    <a href="${html_url}" target="_blank" rel="nooperner noreferrer">${name}</a>  
                </h2>
                <p class="mt-1 text-gray-600 text-sm">${description || "No description provided."}</p>
                <div class="mt-2 flex items-center gap-4">
                    <img src="${owner.avatar_url}" alt="${owner.login}" class="w-8 h-8 rounded-full" />
                    <span class="text-gray-700">@${owner.login}</span>
                    <span class="ml-auto text-sm text-yellow-600 font-semibold ">&#9733; ${stargazers_count}</span>
                </div>
                <button 
                    class="mt-3 px-4 py-2 bg-green-400 hover:bg-green-500 text-white rounded-md transition"
                    onclick="copyToClipboard('${clone_url}')"
                >
                    Copy Clone URL
                </button>
            </div>
        `;
    };

    async function handleSearch() {
        const query = searchInput.value.trim();
        if(!query){
            updateNotification("Please enter a search term.", "text-red-500");
            return;
        }
        updateNotification("Loading Result...", "text-blue-500");
        repositories = await fetchRepositories(query);
        if(repositories.length === 0 ){
            updateNotification(`"No repositories found for "${query}".`, "text-gray-600");
        } else{
            updateNotification("");
            sortButton.classList.remove('hidden');
            displayRepositories(repositories);
        }
    };

    function displayRepositories(repos){
        resultContainer.innerHTML = repos.map(createRepoCard).join("");
        resultContainer.classList.add('h-72');
    };
    function sortRepositories(){
        repositories.sort((a, b) => b.stargazers_count - a.stargazers_count);
        displayRepositories(repositories);
    };
    function copyToClipboard(text){
        navigator.clipboard.writeText(text);
        updateNotification("Clone URL copied to clipboard!", "text-green-500");
    };
    function updateNotification(message, className){
        notification.textContent = message;
        notification.className = `text-sm ${className}`
    };
    searchButton.addEventListener('click', handleSearch);
    sortButton.addEventListener('click', sortRepositories);
    searchInput.addEventListener('keypress', (e) => {
        if(e.key === 'Enter') handleSearch();
    });
</script>