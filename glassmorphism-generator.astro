<div class="bg-gradient-to-tr from-violet-600 via-pink-500 to-amber-400 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden">
    <!-- Ambient floating glowing orbs for authentic glassmorphism refraction -->
    <div class="absolute -top-12 -left-12 w-64 h-64 bg-purple-500/50 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-16 -right-16 w-72 h-72 bg-blue-500/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md bg-white/20 backdrop-blur-md p-6 rounded-3xl shadow-2xl border border-white/30 relative z-10">
        <h2 class="text-2xl font-bold text-center mb-6 text-white drop-shadow-md">
            Glassmorphism Generator
        </h2>

        <!-- Interactive Frosted Glass Card Preview -->
        <div class="flex items-center justify-center h-44 bg-black/10 rounded-2xl mb-6 p-4 border border-white/10 relative overflow-hidden">
            <div id="glassPreview" class="w-48 h-32 rounded-2xl p-4 flex flex-col justify-between text-white shadow-xl transition-all duration-150 border border-white/40">
                <div class="flex items-center space-x-2">
                    <div class="w-3 h-3 rounded-full bg-red-400/80"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-400/80"></div>
                    <div class="w-3 h-3 rounded-full bg-green-400/80"></div>
                </div>
                <div class="text-xs font-semibold tracking-wider uppercase opacity-90">Frosted Glass</div>
            </div>
        </div>

        <!-- Controls -->
        <div class="space-y-3.5 text-sm text-white mb-6">
            <div class="flex justify-between items-center">
                <span>Blur (<span id="valBlur" class="font-mono font-semibold">16px</span>)</span>
                <input id="rangeBlur" type="range" min="0" max="40" value="16" class="w-44 accent-white cursor-pointer" />
            </div>
            <div class="flex justify-between items-center">
                <span>Opacity (<span id="valOpacity" class="font-mono font-semibold">25%</span>)</span>
                <input id="rangeOpacity" type="range" min="5" max="90" value="25" class="w-44 accent-white cursor-pointer" />
            </div>
            <div class="flex justify-between items-center">
                <span>Border Opacity (<span id="valBorder" class="font-mono font-semibold">40%</span>)</span>
                <input id="rangeBorder" type="range" min="0" max="100" value="40" class="w-44 accent-white cursor-pointer" />
            </div>
            <div class="flex justify-between items-center">
                <span>Border Radius (<span id="valRadius" class="font-mono font-semibold">16px</span>)</span>
                <input id="rangeRadius" type="range" min="0" max="48" value="16" class="w-44 accent-white cursor-pointer" />
            </div>
        </div>

        <!-- CSS Code Output & Copy Button -->
        <div class="relative">
            <pre class="bg-black/30 backdrop-blur-sm p-3 rounded-xl text-xs font-mono text-white/90 overflow-x-auto border border-white/10 mb-3"><code id="cssOutput">background: rgba(255, 255, 255, 0.25);
backdrop-filter: blur(16px);
border: 1px solid rgba(255, 255, 255, 0.40);
border-radius: 16px;</code></pre>
            <button id="copyCssBtn" class="w-full bg-white/30 hover:bg-white/40 active:scale-[0.98] text-white font-semibold py-2.5 rounded-xl transition backdrop-blur-md shadow-lg border border-white/40 flex items-center justify-center space-x-2">
                <span>Copy Glass CSS</span>
            </button>
        </div>
    </div>
</div>

<script is:inline>
    const rangeBlur = document.getElementById('rangeBlur');
    const rangeOpacity = document.getElementById('rangeOpacity');
    const rangeBorder = document.getElementById('rangeBorder');
    const rangeRadius = document.getElementById('rangeRadius');

    const valBlur = document.getElementById('valBlur');
    const valOpacity = document.getElementById('valOpacity');
    const valBorder = document.getElementById('valBorder');
    const valRadius = document.getElementById('valRadius');

    const glassPreview = document.getElementById('glassPreview');
    const cssOutput = document.getElementById('cssOutput');
    const copyCssBtn = document.getElementById('copyCssBtn');

    function updateGlass() {
        const blur = rangeBlur.value;
        const opacity = (rangeOpacity.value / 100).toFixed(2);
        const borderOpacity = (rangeBorder.value / 100).toFixed(2);
        const radius = rangeRadius.value;

        valBlur.textContent = `${blur}px`;
        valOpacity.textContent = `${rangeOpacity.value}%`;
        valBorder.textContent = `${rangeBorder.value}%`;
        valRadius.textContent = `${radius}px`;

        glassPreview.style.background = `rgba(255, 255, 255, ${opacity})`;
        glassPreview.style.backdropFilter = `blur(${blur}px)`;
        glassPreview.style.webkitBackdropFilter = `blur(${blur}px)`;
        glassPreview.style.borderColor = `rgba(255, 255, 255, ${borderOpacity})`;
        glassPreview.style.borderRadius = `${radius}px`;

        cssOutput.textContent = `background: rgba(255, 255, 255, ${opacity});\nbackdrop-filter: blur(${blur}px);\nborder: 1px solid rgba(255, 255, 255, ${borderOpacity});\nborder-radius: ${radius}px;`;
    }

    [rangeBlur, rangeOpacity, rangeBorder, rangeRadius].forEach(el => {
        el.addEventListener('input', updateGlass);
    });

    copyCssBtn.addEventListener('click', () => {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(cssOutput.textContent).catch(() => {});
            }
        } catch (e) {}
        copyCssBtn.innerHTML = '<span>Copied to Clipboard! ✓</span>';
        setTimeout(() => {
            copyCssBtn.innerHTML = '<span>Copy Glass CSS</span>';
        }, 1800);
    });

    updateGlass();
</script>
