<div class="bg-gradient-to-br from-slate-950 via-teal-950 to-emerald-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-80 h-80 bg-emerald-600/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-teal-600/30 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-slate-900/85 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl shadow-emerald-950/60 border border-emerald-500/35 relative z-10">
        <div class="flex items-center justify-between mb-6 border-b border-slate-800/80 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-emerald-500/35 flex items-center justify-center text-lg font-bold">🎨</div>
                <div>
                    <h2 class="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-lime-300 tracking-tight">Glassmorphism CSS Generator</h2>
                    <p class="text-xs text-slate-400">Interactive Visual Generator</p>
                </div>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-emerald-950/80 text-emerald-300 border-emerald-500/40 border font-semibold uppercase">CSS & Design</span>
        </div>

        <div class="bg-slate-950/80 p-6 rounded-2xl border border-slate-800 mb-5 flex items-center justify-center min-h-[140px]">
            <div id="visPreview" class="w-36 h-28 rounded-2xl bg-gradient-to-r from-blue-500 to-indigo-600 shadow-2xl transition-all duration-300 flex items-center justify-center text-xs font-mono text-white/90">
                Live Preview
            </div>
        </div>

        <div class="grid grid-cols-2 gap-3 mb-5 text-xs text-slate-300">
            <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex flex-col gap-2">
                <div class="flex justify-between text-slate-400"><span>Spread / Radius</span><span id="lblV1">24px</span></div>
                <input id="visRange1" type="range" min="0" max="60" value="24" class="accent-emerald-500 cursor-pointer" />
            </div>
            <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex flex-col gap-2">
                <div class="flex justify-between text-slate-400"><span>Blur / Intensity</span><span id="lblV2">40px</span></div>
                <input id="visRange2" type="range" min="0" max="100" value="40" class="accent-emerald-500 cursor-pointer" />
            </div>
        </div>

        <div class="flex items-center gap-3">
            <button id="btnDynAction" class="flex-1 bg-gradient-to-r from-emerald-600 via-teal-600 to-lime-500 shadow-emerald-500/30 text-white font-semibold py-3 px-4 rounded-xl shadow-lg transition active:scale-[0.98] flex items-center justify-center gap-2 text-sm">
                <span>⚡ Randomize Style</span>
            </button>
            <button id="btnDynCopy" class="bg-slate-800/90 hover:bg-slate-700 text-white font-semibold py-3 px-5 rounded-xl border border-slate-700 transition active:scale-[0.98] text-sm">
                Copy CSS
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const r1 = document.getElementById('visRange1');
    const r2 = document.getElementById('visRange2');
    const l1 = document.getElementById('lblV1');
    const l2 = document.getElementById('lblV2');
    const prev = document.getElementById('visPreview');
    const btnAct = document.getElementById('btnDynAction');
    const btnCp = document.getElementById('btnDynCopy');

    function update() {
        const v1 = r1.value;
        const v2 = r2.value;
        l1.textContent = v1 + 'px';
        l2.textContent = v2 + 'px';
        prev.style.borderRadius = v1 + 'px';
        prev.style.boxShadow = `0 ${v1/2}px ${v2}px rgba(0,0,0,0.4)`;
    }

    btnAct.onclick = () => {
        r1.value = Math.floor(Math.random() * 50) + 10;
        r2.value = Math.floor(Math.random() * 80) + 20;
        update();
    };

    btnCp.onclick = async () => {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(`border-radius: ${r1.value}px; box-shadow: 0 ${r1.value/2}px ${r2.value}px rgba(0,0,0,0.4);`);
            }
        } catch(e) {}
        btnCp.textContent = 'Copied! ✓';
        btnCp.classList.add('bg-emerald-600');
        setTimeout(() => { btnCp.textContent = 'Copy CSS'; btnCp.classList.remove('bg-emerald-600'); }, 1400);
    };

    r1.oninput = update;
    r2.oninput = update;
    update();
})();
</script>