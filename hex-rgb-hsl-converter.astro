<div class="bg-gradient-to-br from-slate-950 via-indigo-950 to-blue-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-600/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-600/25 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-slate-900/90 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl shadow-blue-950/70 border border-blue-500/35 relative z-10 transition-all duration-300">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-800/80 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-blue-950/80 border border-blue-500/40 flex items-center justify-center text-blue-400 font-mono text-xl font-bold shadow-sm">🎨</div>
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-indigo-300 tracking-tight">HEX ↔ RGB ↔ HSL Converter</h2>
                    <p class="text-xs text-slate-400 font-medium">Real-time bi-directional CSS color space conversion</p>
                </div>
            </div>
            <span id="colorStatus" class="text-xs font-mono px-3 py-1 rounded-full bg-blue-950/80 text-blue-300 border border-blue-500/40 font-semibold shadow-sm">COLOR SPACE ✓</span>
        </div>

        <!-- Color Swatch & Native Picker -->
        <div class="bg-slate-950/80 p-4 rounded-2xl border border-slate-800 mb-4 flex items-center gap-4">
            <div id="swatchBox" class="w-20 h-20 rounded-2xl border-2 border-white/20 shadow-xl transition-all duration-200 shrink-0" style="background-color: #3b82f6;"></div>
            <div class="flex-1">
                <label class="block text-xs font-semibold text-slate-400 mb-1.5">Active Hex Color Code:</label>
                <div class="flex items-center gap-2">
                    <input id="colorInput" type="text" value="#3b82f6" maxlength="9" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm font-mono text-white focus:outline-none focus:border-blue-500 transition select-text" />
                    <input id="nativeColorPicker" type="color" value="#3b82f6" class="w-10 h-10 rounded-xl border border-slate-700 bg-transparent cursor-pointer shrink-0" />
                </div>
            </div>
        </div>

        <!-- Presets -->
        <div class="grid grid-cols-4 gap-2 mb-4 text-xs font-semibold">
            <button class="preset-col py-2 px-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-sky-400 border border-slate-700 transition active:scale-95 text-center truncate" data-hex="#0ea5e9">
                #0ea5e9
            </button>
            <button class="preset-col py-2 px-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-emerald-400 border border-slate-700 transition active:scale-95 text-center truncate" data-hex="#10b981">
                #10b981
            </button>
            <button class="preset-col py-2 px-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-purple-400 border border-slate-700 transition active:scale-95 text-center truncate" data-hex="#8b5cf6">
                #8b5cf6
            </button>
            <button class="preset-col py-2 px-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 transition active:scale-95 text-center truncate" data-hex="#f59e0b">
                #f59e0b
            </button>
        </div>

        <!-- Converted Output Grid -->
        <div class="space-y-2.5 mb-5 text-xs">
            <div class="bg-slate-950/90 p-3 rounded-2xl border border-slate-800 flex items-center justify-between">
                <div>
                    <span class="text-slate-500 text-[10px] uppercase font-bold tracking-wider block">HEX Format</span>
                    <span id="outHex" class="font-mono text-cyan-300 font-bold text-sm">#3B82F6</span>
                </div>
                <button id="btnCopyHex" class="py-1.5 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-lg border border-slate-700 transition active:scale-95">Copy</button>
            </div>
            <div class="bg-slate-950/90 p-3 rounded-2xl border border-slate-800 flex items-center justify-between">
                <div>
                    <span class="text-slate-500 text-[10px] uppercase font-bold tracking-wider block">RGB CSS</span>
                    <span id="outRgb" class="font-mono text-emerald-300 font-bold text-sm">rgb(59, 130, 246)</span>
                </div>
                <button id="btnCopyRgb" class="py-1.5 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-lg border border-slate-700 transition active:scale-95">Copy</button>
            </div>
            <div class="bg-slate-950/90 p-3 rounded-2xl border border-slate-800 flex items-center justify-between">
                <div>
                    <span class="text-slate-500 text-[10px] uppercase font-bold tracking-wider block">HSL CSS</span>
                    <span id="outHsl" class="font-mono text-purple-300 font-bold text-sm">hsl(217, 91%, 60%)</span>
                </div>
                <button id="btnCopyHsl" class="py-1.5 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-lg border border-slate-700 transition active:scale-95">Copy</button>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button id="btnRandomColor" class="flex-1 bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-blue-950/40 transition active:scale-[0.98] text-sm flex items-center justify-center gap-2">
                <span>✨ Random Color</span>
            </button>
            <button id="btnCopyColor" class="bg-slate-800/90 hover:bg-slate-700 text-white font-bold py-3.5 px-5 rounded-xl border border-slate-700 transition active:scale-[0.98] text-sm">
                Copy RGB
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const input = document.getElementById('colorInput');
    const picker = document.getElementById('nativeColorPicker');
    const swatch = document.getElementById('swatchBox');
    const outHex = document.getElementById('outHex');
    const outRgb = document.getElementById('outRgb');
    const outHsl = document.getElementById('outHsl');
    const btnRand = document.getElementById('btnRandomColor');
    const btnCopy = document.getElementById('btnCopyColor');

    function hexToRgb(hex) {
        let c = hex.replace('#', '').trim();
        if (c.length === 3) c = c.split('').map(x => x + x).join('');
        if (c.length !== 6) return null;
        const num = parseInt(c, 16);
        if (isNaN(num)) return null;
        return { r: (num >> 16) & 255, g: (num >> 8) & 255, b: num & 255 };
    }

    function rgbToHsl(r, g, b) {
        r /= 255; g /= 255; b /= 255;
        const max = Math.max(r, g, b), min = Math.min(r, g, b);
        let h, s, l = (max + min) / 2;
        if (max === min) {
            h = s = 0;
        } else {
            const d = max - min;
            s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
            switch (max) {
                case r: h = (g - b) / d + (g < b ? 6 : 0); break;
                case g: h = (b - r) / d + 2; break;
                case b: h = (r - g) / d + 4; break;
            }
            h /= 6;
        }
        return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
    }

    function update(hexVal) {
        const rgb = hexToRgb(hexVal);
        if (!rgb) return;
        const hexNorm = '#' + hexVal.replace('#', '').toUpperCase();
        const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);

        swatch.style.backgroundColor = hexNorm;
        swatch.style.boxShadow = `0 10px 25px ${hexNorm}55`;
        picker.value = hexVal.startsWith('#') ? hexVal : '#' + hexVal;
        outHex.textContent = hexNorm;
        outRgb.textContent = `rgb(${rgb.r}, ${rgb.g}, ${rgb.b})`;
        outHsl.textContent = `hsl(${hsl.h}, ${hsl.s}%, ${hsl.l}%)`;
    }

    input.addEventListener('input', () => update(input.value));
    picker.addEventListener('input', () => {
        input.value = picker.value;
        update(picker.value);
    });

    document.querySelectorAll('.preset-col').forEach(btn => {
        btn.onclick = () => {
            input.value = btn.dataset.hex;
            update(btn.dataset.hex);
        };
    });

    btnRand.onclick = () => {
        const hex = '#' + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0');
        input.value = hex;
        update(hex);
    };

    async function copyVal(val, btnEl) {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(val);
            }
        } catch(e) {}
        const orig = btnEl.textContent;
        btnEl.textContent = 'Copied! ✓';
        btnEl.classList.add('bg-emerald-600', 'text-white');
        setTimeout(() => {
            btnEl.textContent = orig;
            btnEl.classList.remove('bg-emerald-600', 'text-white');
        }, 1400);
    }

    document.getElementById('btnCopyHex').onclick = function() { copyVal(outHex.textContent, this); };
    document.getElementById('btnCopyRgb').onclick = function() { copyVal(outRgb.textContent, this); };
    document.getElementById('btnCopyHsl').onclick = function() { copyVal(outHsl.textContent, this); };
    btnCopy.onclick = function() { copyVal(outRgb.textContent, btnCopy); };

    update(input.value);
})();
</script>