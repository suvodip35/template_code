<div class="bg-slate-900 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden">
    <!-- Ambient glowing backgrounds -->
    <div class="absolute -top-16 -left-16 w-72 h-72 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -right-20 w-80 h-80 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md bg-slate-800/90 backdrop-blur-xl p-6 rounded-3xl shadow-2xl border border-slate-700/60 relative z-10">
        <h2 class="text-2xl font-bold text-center mb-6 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400">
            HEX RGB HSL Color Converter
        </h2>

        <!-- Interactive Preview Area -->
        <div class="flex items-center justify-center h-44 bg-slate-900/80 rounded-2xl mb-6 p-4 border border-slate-800 relative overflow-hidden">
            <div id="livePreviewBox" class="w-36 h-28 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex flex-col items-center justify-center text-white shadow-xl transition-all duration-150 p-3 text-center">
                <span class="text-xs font-semibold uppercase tracking-wider opacity-80">CSS & Design</span>
                <span id="previewMetric" class="text-lg font-bold mt-1">Active</span>
            </div>
        </div>

        <!-- User Controls -->
        <div class="space-y-3.5 text-sm text-slate-300 mb-6">
            <div class="flex justify-between items-center">
                <span>Bidirectional (<span id="val1" class="font-mono text-indigo-400 font-semibold">50%</span>)</span>
                <input id="range1" type="range" min="10" max="100" value="50" class="w-40 accent-indigo-500 cursor-pointer" />
            </div>
            <div class="flex justify-between items-center">
                <span>Live (<span id="val2" class="font-mono text-indigo-400 font-semibold">24px</span>)</span>
                <input id="range2" type="range" min="4" max="64" value="24" class="w-40 accent-indigo-500 cursor-pointer" />
            </div>
            <div class="flex justify-between items-center">
                <span>Alpha (<span id="val3" class="font-mono text-indigo-400 font-semibold">80%</span>)</span>
                <input id="range3" type="range" min="10" max="100" value="80" class="w-40 accent-indigo-500 cursor-pointer" />
            </div>
        </div>

        <!-- Output Code & Copy Button -->
        <div class="relative">
            <pre class="bg-slate-950/80 p-3 rounded-xl text-xs font-mono text-slate-300 overflow-x-auto border border-slate-800 mb-3"><code id="codeOutput">/* Generated Configuration */
--component-scale: 50%;
--border-radius: 24px;
--opacity-level: 80%;</code></pre>

            <button id="copyActionBtn" class="w-full bg-gradient-to-r from-indigo-500 to-blue-600 hover:from-indigo-600 hover:to-blue-700 active:scale-[0.98] text-white font-semibold py-2.5 rounded-xl transition shadow-lg shadow-indigo-500/25 flex items-center justify-center space-x-2">
                <span>Copy Code</span>
            </button>
        </div>
    </div>
</div>

<script is:inline>
    const liveBox = document.getElementById('livePreviewBox');
    const range1 = document.getElementById('range1');
    const range2 = document.getElementById('range2');
    const range3 = document.getElementById('range3');
    const val1 = document.getElementById('val1');
    const val2 = document.getElementById('val2');
    const val3 = document.getElementById('val3');
    const codeOutput = document.getElementById('codeOutput');
    const copyBtn = document.getElementById('copyActionBtn');
    const previewMetric = document.getElementById('previewMetric');

    function updatePreview() {
        const v1 = range1.value;
        const v2 = range2.value;
        const v3 = range3.value;

        val1.textContent = v1 + '%';
        val2.textContent = v2 + 'px';
        val3.textContent = v3 + '%';

        if (liveBox) {
            liveBox.style.borderRadius = v2 + 'px';
            liveBox.style.opacity = (v3 / 100);
            liveBox.style.transform = `scale(${0.8 + (v1 / 250)})`;
        }

        if (previewMetric) {
            previewMetric.textContent = v1 + ' • ' + v2 + 'px';
        }

        if (codeOutput) {
            codeOutput.textContent = `/* HEX RGB HSL Color Converter */\n--component-scale: ${v1}%;\n--border-radius: ${v2}px;\n--opacity-level: ${v3}%;`;
        }
    }

    [range1, range2, range3].forEach(input => {
        if (input) input.addEventListener('input', updatePreview);
    });

    if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(codeOutput ? codeOutput.textContent : '');
                const originalText = copyBtn.innerHTML;
                copyBtn.innerHTML = '<span>Copied! ✓</span>';
                copyBtn.classList.add('bg-emerald-600');
                setTimeout(() => {
                    copyBtn.innerHTML = originalText;
                    copyBtn.classList.remove('bg-emerald-600');
                }, 1800);
            } catch (e) {
                copyBtn.textContent = 'Copied! ✓';
            }
        });
    }

    updatePreview();
</script>