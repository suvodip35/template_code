<div class="bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center min-h-screen text-white">
    <div class="bg-white rounded-lg shadow-lg p-6 text-center text-gray-800 max-w-md w-full">
        <h1 class="text-2xl font-extrabold mb-4 text-purple-700">
            Image Background Remover
        </h1>
        <p class="text-gray-600 mb-6">
            Upload an image, we'll remove the background for you!
        </p>
        <input
            type="file"
            id="imageInput"
            accept="image/*"
            class="block w-full text-gray-600 border border-gray-300 rounded-lg py-2 px-3 mb-4 focus:outline-none focus:ring-2 focus:ring-purple-500"
            
        />
        <p id="message" class="text-sm text-red-600 hidden"></p>
        <div class="flex justify-between gap-2">
            <button
                id="processButton"
                class="w-full p-2 bg-purple-600 text-white rounded-lg font-semibold hover:bg-purple-700 transition">
                Remove Background
            </button>
            <button
                id="downloadButton"
                class="hidden w-full p-2 bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 transition">
                Download Image
            </button>
        </div>
        <div id="loading" class="mt-4 hidden">
            <p class="text-sm text-blue-500">
                Processing your image...
            </p>
        </div>
        <div id="outputContainer" class="hidden mt-6">
            <img 
                id="outputImage"
                class="rounded-lg shadow-md max-w-full mx-auto w-96"
                alt="Processed Image">
        </div>
    </div>
</div>
<script is:inline>
    const imageInput = document.getElementById('imageInput');
    const processButton = document.getElementById('processButton');
    const outputContainer = document.getElementById('outputContainer');
    const outputImage = document.getElementById('outputImage');
    const downloadButton = document.getElementById('downloadButton');
    const message = document.getElementById('message');
    const loading = document.getElementById('loading');

    const API_KEY = 'YOUR_API_KEY';

    processButton.addEventListener('click', async () => {
        const file = imageInput.files[0];

        if(!file){
            showMessage('Please upload an image.', 'error');
            return;
        }
        if(file.size > 5 * 1024 * 1024){
            showMessage('File size exceeds 5MB. Please upload a smaller file.', 'error');
            return;
        }

        const formData = new FormData();
        formData.append('image_file', file);
        formData.append('size', 'auto');
        loading.classList.remove('hidden');
        message.classList.add('hidden');
        downloadButton.classList.remove('hidden');

        try{
            const response = await fetch('https://api.remove.bg/v1.0/removebg', {
                method: 'POST',
                headers: {
                    'X-Api-Key' : API_KEY,
                },
                body: formData,
            });

            if(!response.ok){
                throw new Error('Faild to process the image. Please try again.');
            }

            const blob = await response.blob();
            const url = URL.createObjectURL(blob);

            outputImage.src = url;
            downloadButton.onclick = () => downloadImage(url, 'Processed-image.png');
            outputContainer.classList.remove('hidden');
            loading.classList.add('hidden');
            showMessage('Background Removed successfully!', 'success');
        } catch(error){
            loading.classList.add('hidden');
            showMessage(error.message, 'error');
        }
    });


    function showMessage(text, type){
        message.text = text;
        message.classList.remove('hidden');
        message.classList.toggle('text-red-600', type === 'error');
        message.classList.toggle('text-green-600', type === 'success');
    }

    function downloadImage(url, filename){
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.removeChild(a);
    };

</script>
