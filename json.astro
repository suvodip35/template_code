<div class="bg-gradient-to-br from-red-500 via-pink-500 to-purple-500 text-white
    flex justify-center items-center min-h-screen p-5">
    <div class="max-w-lg w-full bg-white p-6 rounded-lg shadow-lg text-gray-800">
        <h1 class="text-3xl font-bold text-center text-purple-500">
            Fake JSON Data Generator
        </h1>
        <div class="mt-4">
            <label 
                for=""
                class="block text-sm font-medium">
                Fields (comma-separated):
            </label>
            <input
                type="text"
                id="fields"
                placeholder="e.g., name, email, phone"
                class="w-full p-2 rounded border-2 border-purple-500 mt-2 focus:outline-red-500">
        </div>
        <div class="mt-4">
            <label
                for=""
                class="block text-sm font-medium">
                Number of Records:
            </label>
            <input
                type="number"
                id="count"
                min="1"
                max="50"
                value="5"
                class="w-full p-2 rounded border-2 border-purple-500 mt-2 focus:outline-red-500"
            />
        </div>
        <button
            onclick="generateData()"
            class="w-full mt-4 bg-indigo-500 hover:bg-indigo-600 text-white font-bold py-2 rounded transition duration-300">
            Generate Data
        </button>
        <button
            onclick="downloadJSON()"
            id="downloadBtn"
            disabled
            class="w-full mt-2 bg-green-500 hober:bg-green-600 text-white font-bold py-2 rounded
            transition duration-300 opacity-50 cursor-not-allowed">
            Download JSON
        </button>
        <div id="output" class="mt-4 p-3 bg-gray-100 rounded text-sm overflow-auto max-h-60 hidden"></div>
    </div>
</div>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Faker/3.1.0/faker.min.js"></script>
<script is:inline>

    let jsonData = [];

    function  generateData(){
        const fields = document.getElementById('fields').value.split(',').map(f => f.trim());
        const count = parseInt(document.getElementById('count').value);
        let data = [];

        for (let i = 0; i < count; i++){
            let item = {};
            fields.forEach(field => {
                if(field === 'name'){item[field] = faker.name.findName()}
                else if(field === ' email'){item[field] = faker.internet.email()}
                else if(field === 'phone'){item[field] = faker.phone.phoneNumber()}
                else if(field === 'address'){item[field] = faker.address.streetAddress()}
                else if(field === 'company'){item[field] = faker.address.companyName()}
                else item[field] = faker.lorem.words(3);
            });
            data.push(item);
        }
        jsonData = data;
        document.getElementById('output').classList.remove('hidden');
        document.getElementById('output').innerHTML = `<pre>${JSON.stringify(data, null, 2)}</pre>`;

        const downloadBtn = document.getElementById('downloadBtn');
        downloadBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        downloadBtn.disabled = false;
    }

    function downloadJSON(){
        if(jsonData.length === 0) return;
        const blob = new Blob([JSON.stringify(jsonData, null, 2)], {type: 'application/json'});
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'fake_json_data.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>