<div class="min-h-screen bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center p-4">
    <div class="bg-white shadow-lg rounded-lg p-6 max-w-md w-full">
        <h1 class="text-2xl font-bold text-gray-800 mb-4 text-center">
            MD5 Hash Generator
        </h1>
        <textarea
            id="inputText"
            class="w-full border border-gray-300 rounded-md p-3 text-gray-700 focu:ring-2 focus:ring-purple-500"
            rows="5"
            placeholder="Enter text here..."></textarea>

            <div class="mt-4 text-sm text-gray-600">
                <p>Character Count: <span id="charCount">0</span></p>
                <p>Word Count: <span id="wordCount">0</span></p>
            </div>
            <div class="mt-4 bg-gray-100 p-3 rounded-md">
                <div class="flex justify-between items-center">
                    <p class="text-gray-700 text-sm font-mono break-words font-bold" id="hashOutput">
                        Hash will appear here...
                    </p>
                    <button
                        id="visibilityToggle"
                        class="text-purple-500 hover:underline text-sm">
                        Hide
                    </button>
                </div>
            </div>
            <div class="mt-4">
                <p class="text-gray-600 text-sm font-mono bg-gray-50 p-2 rounded" id="preview">
                    Live Preview:
                </p>
            </div>
            <div class="flex justify-between mt-4">
                <button
                    id="copyButton"
                    class="bg-purple-500 text-white px-4 py-2 rounded-md shadow hover:bg-purple-600 focus:outline-none">
                    Copy Hash
                </button>
                <button
                    id="downloadButton"
                    class="bg-blue-500 text-white px-4 py-2 rounded-md shadow hover:bg-blue-600 focus:outline-none">
                    Download Hash
                </button>
                <button
                    id="clearButton"
                    class="bg-red-500 text-white px-4 py-2 rounded shadow hover:bg-red-600 focus:outline-none">
                    Clear
                </button>
            </div>
            <p id="feedbackMessage" class="mt-4 text-center text-sm text-green-500"></p>
    </div>
</div>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
<script is:inline>
    const inputText = document.getElementById('inputText');
    const charCount = document.getElementById('charCount');
    const wordCount = document.getElementById('wordCount');
    const hashOutput = document.getElementById('hashOutput');
    const copyButton = document.getElementById('copyButton');
    const downloadButton = document.getElementById('downloadButton');
    const clearButton = document.getElementById('clearButton');
    const visibilityToggle = document.getElementById('visibilityToggle');
    const preview = document.getElementById('preview');
    const feedbackMessage = document.getElementById('feedbackMessage');

    let isHashVisible = true;

    inputText.addEventListener('input', () => {
        const text = inputText.value;
        charCount.textContent = text.length;
        wordCount.textContent = text.trim() ? text.trim().split(/\s+/).length : 0;
        hashOutput.textContent = text ? CryptoJS.MD5(text).toString() : 'Hash will appear here...';
        preview.textContent = `Live Preview: ${text}`;
    });
    copyButton.addEventListener('click', () => {
        if(hashOutput.textContent && hashOutput.textContent !== 'Hash will appear here...'){
            navigator.clipboard.writeText(hashOutput.textContent).then(() => {
                showMessage('Hash copied to clipboard!', 'text-green-500');
            })
        } else{
            showMessage('No hash to copy!', 'text-red-500');
        }
    });
    downloadButton.addEventListener('click', () => {
        const hash = hashOutput.textContent;
        if(hash && hash !== 'Hash will appear here...'){
            const blob = new Blob([hash], {type: 'text/plain'});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'md5-hash.txt';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            showMessage('Hash Downloaded as md5-hash.txt!', 'text-green-500');
        } else{
            showMessage('No Hash to downloaded!', 'text-red-500');
        }
    });
    clearButton.addEventListener('click', () => {
        inputText.value = '';
        charCount.textContent = '0';
        wordCount.textContent = '0';
        hashOutput.textContent = 'Hash will appear here...';
        preview.textContent = 'Live Preview';
        showMessage('Cleared all fields.', 'text-yellow-500');
    });
    visibilityToggle.addEventListener('click', () => {
        isHashVisible = !isHashVisible;
        hashOutput.style.display = isHashVisible ? 'block' : 'none';
        visibilityToggle.textContent = isHashVisible ? 'Hide' : 'Show' 
    });

    function showMessage(message, colorClass){
        feedbackMessage.textContent = message;
        feedbackMessage.className = `mt-4 text-center text-sm ${colorClass}`;
    }

</script>