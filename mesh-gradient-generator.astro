<div class="bg-gradient-to-br from-amber-400 via-orange-500 to-rose-500 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-white/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-white/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-white shadow-2xl rounded-2xl p-6 sm:p-8 border-t-8 border-orange-500 relative z-10 transition-all duration-300">
        <div class="flex items-center justify-between mb-6 border-b border-slate-100 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-orange-50 border border-orange-200 text-orange-600 flex items-center justify-center text-xl font-bold shadow-sm">🎨</div>
                <div>
                    <h2 class="text-xl font-extrabold text-slate-800 tracking-tight">Fluid Mesh Gradient Generator</h2>
                    <p class="text-xs text-slate-500 font-medium">Interactive Visual Generator</p>
                </div>
            </div>
            <span class="text-xs font-mono px-3 py-1 rounded-full bg-orange-50 text-orange-700 border border-orange-200 font-semibold uppercase shadow-sm">CSS & Design</span>
        </div>

        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 mb-5 flex items-center justify-center min-h-[140px]">
            <div id="visPreview" class="w-36 h-28 rounded-2xl bg-gradient-to-r from-indigo-500 to-purple-600 shadow-xl transition-all duration-300 flex items-center justify-center text-xs font-mono text-white font-bold">
                Live Preview
            </div>
        </div>

        <div class="grid grid-cols-2 gap-3 mb-5 text-xs text-slate-700">
            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 flex flex-col gap-2">
                <div class="flex justify-between font-semibold text-slate-600"><span>Spread / Radius</span><span id="lblV1" class="text-indigo-600 font-bold">24px</span></div>
                <input id="visRange1" type="range" min="0" max="60" value="24" class="accent-indigo-600 cursor-pointer" />
            </div>
            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 flex flex-col gap-2">
                <div class="flex justify-between font-semibold text-slate-600"><span>Blur / Intensity</span><span id="lblV2" class="text-indigo-600 font-bold">40px</span></div>
                <input id="visRange2" type="range" min="0" max="100" value="40" class="accent-indigo-600 cursor-pointer" />
            </div>
        </div>

        <div class="flex items-center gap-3">
            <button id="btnDynAction" class="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white shadow-lg shadow-emerald-500/25 font-bold py-3.5 px-4 rounded-xl transition active:scale-[0.98] flex items-center justify-center gap-2 text-sm">
                <span>⚡ Randomize Style</span>
            </button>
            <button id="btnDynCopy" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-3.5 px-5 rounded-xl border border-slate-300 transition active:scale-[0.98] text-sm">
                Copy CSS
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const r1 = document.getElementById('visRange1');
    const r2 = document.getElementById('visRange2');
    const l1 = document.getElementById('lblV1');
    const l2 = document.getElementById('lblV2');
    const prev = document.getElementById('visPreview');
    const btnAct = document.getElementById('btnDynAction');
    const btnCp = document.getElementById('btnDynCopy');

    function update() {
        const v1 = r1.value;
        const v2 = r2.value;
        l1.textContent = v1 + 'px';
        l2.textContent = v2 + 'px';
        prev.style.borderRadius = v1 + 'px';
        prev.style.boxShadow = `0 ${v1/2}px ${v2}px rgba(0,0,0,0.2)`;
    }

    btnAct.onclick = () => {
        r1.value = Math.floor(Math.random() * 50) + 10;
        r2.value = Math.floor(Math.random() * 80) + 20;
        update();
    };

    btnCp.onclick = async () => {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(`border-radius: ${r1.value}px; box-shadow: 0 ${r1.value/2}px ${r2.value}px rgba(0,0,0,0.2);`);
            }
        } catch(e) {}
        btnCp.textContent = 'Copied! ✓';
        btnCp.classList.add('bg-emerald-600', 'text-white');
        setTimeout(() => {
            btnCp.textContent = 'Copy CSS';
            btnCp.classList.remove('bg-emerald-600', 'text-white');
        }, 1400);
    };

    r1.oninput = update;
    r2.oninput = update;
    update();
})();
</script>