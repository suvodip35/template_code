<div class="bg-gradient-to-r from-purple-400 via-pink-500 to-red-500 flex items-center justify-center min-h-screen">
    <button 
        id="openModal"
        class="bg-gradient-to-r from-green-400 via-blue-500 to-purple-500 text-white font-bold px-6 py-3 rounded-full
        hover:shadow-lg transition transform hover:scale-105 duration-300">
        Open Modal
    </button>
    <div 
        id="modal" 
        class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center hidden z-50">
        <div class="modal-animate bg-white p-8 rounded-2xl shadow-2xl max-w-lg w-full relative">
            <button 
                id="closeModal"
                class="text-4xl font-bold absolute top-4 right-4 text-gray-500 hover:text-red-500 transition duration-200">
                &times;
            </button>
            <h2 class="text-3xl font-bold text-purple-600 mb-4 text-center">
                Welcome Message Here
            </h2>
            <p class="text-gray-600 text-center mb-6">
                This premium modal includes interactive features, beautiful 
                color gradients, and animated transitions to enhance user engagement.
            </p>
            <div class="flex justify-center mb-4">
                <button 
                    class="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 text-white font-semibold 
                    px-6 py-3 rounded-full hover:shadow-lg transition transform hover:scale-105 duration-500">
                    Explore More
                </button>
            </div>
            <p class="text-sm text-gray-400 text-center">
                By proceeding, you agree to our 
                <a href="#" class="text-blue-500 hover:underline">
                    Terms & Conditions
                </a>.
            </p>
        </div>
    </div>
</div>
<script is:inline>
    const openModalButton = document.getElementById('openModal');
    const closeModalButton = document.getElementById('closeModal');
    const modal = document.getElementById('modal');
    openModalButton.addEventListener('click', function() {
        modal.classList.remove('hidden');
    });
    closeModalButton.addEventListener('click', function() {
        modal.classList.add('hidden');
    });
</script>
<style>
    @keyframes slideDown {
        0% {
            transform: translateY(-50px);
            opacity: 0;
        }
        100% {
            transform: translateY(0);
            opacity: 1;
        }
    }
    .modal-animate{
        animation: slideDown 0.3s ease-out;
    }
</style>