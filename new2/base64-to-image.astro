<div class="bg-gradient-to-r from-purple-500 to-blue-600 flex items-center justify-center min-h-screen text-white">
    <div class="w-full max-w-md p-8 bg-white rounded-xl shadow-xl text-gray-800">
        <h2 class="text-2xl font-bold text-center text-purple-700 mb-6">
            Base64 to Image Converter
        </h2>
        <p id="statusMessage" class="text-center text-red-500 font-medium mb-4 hidden">
            Please enter a valid Base64 string.
        </p>
        <textarea
            rows="5"
            id="base64Input"
            class="w-full p-3 bg-gray-100 border border-gray-300 rounded-lg focus:border-purple-500
            outline-none resize-none transition-all duration-300 ease-in-out mb-4"
            placeholder="Paste your Base64 string here"></textarea>
        
        <button
            onclick="convertToImage();"
            id="convertButton"
            class="w-full py-2 bg-purple-600 hover:bg-purple-700 text-white font-semibold 
            rounded-lg shadow-md transition-transfomr mb-4">
            Convert to Image
        </button>
        <button
            onclick="downloadImage();"
            id="downloadButton"
            class="w-full py-2 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-lg
            shadow-md transition-transform mt-4 hidden">
            Download Image
        </button>

        <div id="imageContainer" class="mt-6 hidden">
            <img id="outputImage"
                class="w-full rounded-lg shadow-md border-2 border-purple-400 transition-all duration-300 ease-in-out"
                alt="Base64 Image Preview"
            />
        </div>
    </div>
</div>
<script is:inline>
    function convertToImage(){
        const base64Input = document.getElementById('base64Input').value;
        const imageContainer = document.getElementById('imageContainer');
        const outputImage = document.getElementById('outputImage');
        const downloadButton = document.getElementById('downloadButton');
        const statusMessage = document.getElementById('statusMessage');

        if(!base64Input.trim()){
            statusMessage.textContent = 'Please enter a valid Base64 string';
            statusMessage.classList.remove('hidden');
            return;
        } else{
            statusMessage.classList.add('hidden');
        }
        outputImage.src = `data:image/png;base64,${base64Input}`;
        imageContainer.classList.remove('hidden');
        downloadButton.classList.remove('hidden');

    };
    function downloadImage(){
        const outputImage = document.getElementById('outputImage');
        const link = document.createElement('a');
        link.href = outputImage.src;
        link.download = 'downloaded_image.png';
        link.click();
    }
</script>