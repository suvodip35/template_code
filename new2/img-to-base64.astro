<div class="flex items-center justify-center min-h-screen bg-gradient-to-r from-blue-500 via-purple-600 to-pink-500 text-white">
    <div class="w-full max-w-lg bg-white rounded-lg shadow-lg text-gray-800 p-6">
        <h2 class="text-2xl font-bold mb-4 text-center text-purple-600">
            Image to Base64 Converter
        </h2>
        <input
            type="file"
            id="imageInput"
            accept="image/*"
            class="w-full p-2 mb-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2
            focus:ring-purple-600 transition"
            onchange="convertToBase64()" 
        />
        <textarea
            id="base64Output"
            rows="6"
            class="w-full p-3 border border-gray-300 rounded-lg resize-none mb-4 focus:outline-none
            focus:ring-2 focus:ring-purple-600 transition"
            placeholder="Base64 output..."></textarea>
        
        <div class="flex justify-between mt-4">
            <button
            onclick="copyToClipboard();"
                class="bg-purple-600 text-white py-2 px-4 rounded-lg hover:bg-purple-700 transition-colors">
                Copy
            </button>
            <button
                onclick="clearOutput();"
                class="bg-red-500 text-white py-2 px-4 rounded-lg hover:bg-red-600 transition-colors">
                Clear
            </button>
            <button
            onclick="downloadBase64();"
                class="bg-green-600 text-white py-2 px-4 rounded-lg hover:bg-green-700 transition-colors">
                Download
            </button>
        </div>
        <p id="message" class="mt-4 text-center text-sm font-semibold text-indigo-600"></p>
    </div>
</div>
<script is:inline>
    function showMessage(message, color){
        const messageElement = document.getElementById('message');
        messageElement.textContent = `${message}`;
        messageElement.className = `mt-4 text-center text-sm font-semibold ${color}`;
        setTimeout(() => {
            messageElement.textContent = '';
        }, 3000);

    } 
    function convertToBase64(){
        const fileInput = document.getElementById('imageInput');
        const base64Output = document.getElementById('base64Output');

        if(fileInput.files.length > 0){
            const file = fileInput.files[0];
            const reader = new FileReader();

            reader.onload = function (event){
                base64Output.value = event.target.result;
                showMessage("Image converted to Base64 successfully!", "text-green-600");
            };
            reader.readAsDataURL(file);
        } else{
            showMessage("Please select an image file first", "text-red-500");
        }
    };
    function copyToClipboard(){
        const base64Output = document.getElementById('base64Output');
        if(base64Output.value){
            navigator.clipboard.writeText(base64Output.value).then(() => {
                showMessage("Base64 copied to clipboard!", "text-green-600");
            });
        } else{
            showMessage("Nothing to copy!", "text-red-500");
        }
    }
    function clearOutput(){
        document.getElementById('imageInput').value = '';
        document.getElementById('base64Output').value = '';
        showMessage("Cleared input and output fields.", "text-blue-600");
    };
    function downloadBase64(){
        const base64Output = document.getElementById('base64Output').value;
        if(base64Output){
            const link = document.createElement('a');
            link.href = base64Output;
            link.download = 'converted-image.png';
            link.click();
            showMessage("Image downloaded successfully!", "text-green-600");
        }else{
            showMessage("No Base64 data to download!", "text-red-500");
        }
    }
</script>