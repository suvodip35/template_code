<div class="bg-gradient-to-r from-red-500 via-purple-500 to-pink-500 text-gray-800 font-sans min-h-screen flex items-center justify-center p-4">
    <div class="max-w-lg w-full p-6 bg-white rounded-lg shadow-lg">
        <h1 class="text-2xl font-bold text-center text-blue-500 mb-6">
            Planetary Weight Calculator &#127757;
        </h1>
        <div class="mb-6">
            <label 
                for="weight"
                class="block text-lg font-semibold mb-2">
                Your Weight on Earth (kg): 
        </label>
        <input 
            oninput="calculateWeight();"
            type="number" 
            placeholder="Enter your weight"
            id="weight"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
        </div>
        <p class="text-center text-gray-600 mb-4">
            Enter your weight to see how it changes across different planets!
        </p>
        <div id="planetGrid" class="grid grid-cols-2 gap-4"></div>
    </div>
</div>
<script is:inline>
      const planets = [
    { name: "Mercury", gravity: 3.7, color: "bg-yellow-200" },
    { name: "Venus", gravity: 8.87, color: "bg-pink-200" },
    { name: "Mars", gravity: 3.71, color: "bg-red-200" },
    { name: "Jupiter", gravity: 24.79, color: "bg-orange-200" },
    { name: "Saturn", gravity: 10.44, color: "bg-yellow-300" },
    { name: "Uranus", gravity: 8.69, color: "bg-blue-200" },
    { name: "Neptune", gravity: 11.15, color: "bg-indigo-200" }
  ];

  function calculateWeight(){
    const earthWeight = parseFloat(document.getElementById('weight').value);
    if(!isNaN(earthWeight) && earthWeight > 0){
        planets.forEach(planet => {
            const planetWeight = (earthWeight * planet.gravity / 9.81).toFixed(2);
            document.getElementById(`${planet.name}Weight`).textContent = `${planetWeight} kg`;
        });
    } else{
        planets.forEach(planet => {
            document.getElementById(`${planet.name}Weight`).textContent = '0 kg';
        })
    }
  }
  function renderPlanets(){
    const planetGrid = document.getElementById('planetGrid');
    planets.forEach(planet => {
        const planetCard = document.createElement('div');
        planetCard.className = `${planet.color}  rounded-lg p-4 text-center transform hover:scale-105 transition-transform`;

        planetCard.innerHTML = `
            <h2 class="text-lg font-semibold text-gray-700">
                ${planet.name}
            </h2>
            <p class="text-2xl font-bold mt-2 text-gray-900" id="${planet.name}Weight">
                0 kg
            </p>
        `;
        planetGrid.appendChild(planetCard);
    })
  };
  renderPlanets();

</script>