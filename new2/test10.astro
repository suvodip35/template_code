<div class="flex items-center justify-center min-h-screen bg-gradient-to-r from-purple-500 via-pink-500 to-red-500">
    <div class="w-full max-w-md p-8 mx-auto bg-white rounded-lg shadow-lg">
        <h1 class="text-2xl font-bold text-center text-gray-800 mb-6">
            BMI Calculator
        </h1>
        <div class="mb-4">
            <label 
                for="height"
                class="block text-gray-700 font-semibold">
                Height (cm):
            </label>
            <input 
                type="number" 
                placeholder="Enter your height"
                id="height"
                class="w-full p-3 mt-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2
                focus:ring-blue-400"
            />
        </div>
        <div class="mb-4">
            <label 
                for="weight"
                class="block text-gray-700 font-semibold">
                Weight (kg):
            </label>
            <input 
                type="number" 
                placeholder="Enter your weight"
                id="weight"
                class="w-full p-3 mt-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 
                focus:ring-blue-400"
            />
        </div>
        <p 
            id="alertMessage"
            class="text-red-500 text-center font-medium hidden">
            Please enter valid height and weight values.
        </p>
        <button
            onclick="calculateBMI()"
            class="w-full py-3 mt-4 text-white bg-gradient-to-r from-blue-500 to-teal-500 rounded-lg
            hover:from-teal-500 hover:to-blue-500 transition duration-300 font-semibold">
            Calculate BMI
        </button>
        <div id="result" class="mt-6 p-4 text-center bg-gray-100 rounded-lg hidden">
            <p class="text-lg font-semibold text-gray-800">Your BMI: <span id="bmiValue"></span></p>
            <p id="bmiStatus" class="text-sm mt-2 font-medium"></p>
        </div>
        <div class="mt-6">
            <canvas id="bmiChart" width="400" height="200"></canvas>
        </div>
    </div>
</div>
<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script is:inline>
    let bmiChart;

    function calculateBMI(){
        const height = parseFloat(document.getElementById('height').value) / 100;
        const weight = parseFloat(document.getElementById('weight').value);
        const bmi = (weight / (height * height)).toFixed(1);
        const result = document.getElementById('result');
        const bmiValue = document.getElementById('bmiValue');
        const bmiStatus = document.getElementById('bmiStatus');
        const alertMessage = document.getElementById('alertMessage');

        if(!isNaN(bmi) && height > 0 && weight > 0){
            bmiValue.textContent = bmi;
            result.classList.remove('hidden');
            alertMessage.classList.add('hidden');
            
            if(bmi < 18.5){
                bmiStatus.textContent = "Underweight";
                bmiStatus.classList = 'text-yellow-500 font-bold';
            } else if(bmi >= 18.5 && bmi <= 24.9){
                bmiStatus.textContent = "Normal Weight";
                bmiStatus.classList = 'text-green-500 font-bold';
            } else if(bmi >= 25 && bmi <= 29.9){
                bmiStatus.textContent = "Overweight";
                bmiStatus.classList = 'text-orange-500 font-bold';
            } else{
                bmiStatus.textContent = "Obese";
                bmiStatus.classList = 'text-red-500 font-bold';
            }
            updateChart(bmi);
        } else{
            alertMessage.classList.remove('hidden');
            result.classList.add('hidden');
        }
    }
    function updateChart(bmi){
            const ctx = document.getElementById('bmiChart').getContext('2d');

            if(bmiChart){
                bmiChart.destroy();
            }
            bmiChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Underweight', 'Normal weight', 'Overweight', 'Obese'],
                    datasets: [{
                        label: 'BMI Range',
                        data: [18.5, 24.9, 29.9, 35],
                        backgroundColor: [
                            bmi < 18.5 ? 'rgba(255, 206, 86, 0.6)' : 'rgba(255, 206, 86, 0.2)',
                            bmi >= 18.5 && bmi <= 24.9 ? 'rgba(75, 192, 192, 0.6)' : 'rgba(75, 192, 192, 0.2)',
                            bmi >= 25 && bmi <= 29.9 ? 'rgba(255, 159, 64, 0.6)' : 'rgba(255, 159, 64, 0.2)',
                            bmi >= 30 ? 'rgba(255, 99, 132, 0.6)' : 'rgba(255, 99, 132, 0.2)',
                        ],
                        borderColor: [
                            'rgba(255, 206, 86, 1)',
                            'rgba(75, 192, 192, 1)',
                            'rgba(255, 159, 64, 1)',
                            'rgba(255, 99, 132, 1)',
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 40,
                        }
                    }
                }
            })
        }
</script>
