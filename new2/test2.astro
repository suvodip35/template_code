<div class="bg-gradient-to-r from-purple-400 via-pink-500 to-red-500 flex items-center 
    justify-center min-h-screen text-white">
    <div class="max-w-lg w-full bg-white p-8 rounded-lg shadow-lg text-gray-900">
        <h2 class="text-2xl font-bold text-center mb-6">
            Barcode Generator
        </h2>
        <form id="barcodeForm" class="space-y-4">
            <div>
                <label 
                    for="barcodeValue"
                    class="block font-semibold mb-1">
                    Enter Barcode Value
                </label>
                <input 
                    type="text"
                    id="barcodeValue"
                    required
                    placeholder="Enter numeric value!"
                    class="w-full p-2 border rounded-lg focus:outline-none focus:ring-2
                    focus:ring-blue-400">
                    <span id="error" class="text-red-500 hidden">
                        Please enter a valid numeric value!
                    </span>
            </div>
            <div class="flex space-x-4">
                <div>
                    <label 
                        for="format" 
                        class="block font-semibold mb-1">
                        Select Barcode Format
                    </label>
                    <select 
                        id="format"
                        class="w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
                        <option value="CODE128">CODE128</option>
                        <option value="EAN">EAN</option>
                        <option value="UPC">UPC</option>
                    </select>
                </div>
                <div>
                    <label 
                        for="color"
                        class="block font-semibold mb-1">
                        Choose Barcode Color
                    </label>
                    <input 
                        type="color" 
                        value="#000000" 
                        id="color"
                        class="w-full rounded-lg h-[40px]">
                </div>
            </div>
            <button 
                type="submit"
                class="w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600 transition">
                Generate Barcode
            </button>
        </form>
        <div id="spinner" class="hidden flex justify-center my-4">
            <div class="spinner"></div>
        </div>
        <div id="barcodeWrapper" class="mt-6 hidden">
            <svg id="barcode" class="w-full h-24 mb-4"></svg>
            <button 
                id="download"
                class="w-full bg-green-500 text-white py-2 rounded-lg hover:bg-green-600 transition">
                Download Barcode
            </button>
        </div>
    </div>
</div>
<script is:inline src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
<script is:inline>
    const form = document.getElementById('barcodeForm');
    const barcodeSvg = document.getElementById('barcode');
    const barcodeWrapper = document.getElementById('barcodeWrapper');
    const spinner = document.getElementById('spinner');
    const error = document.getElementById('error');
    const downloadBtn = document.getElementById('download');

    form.addEventListener('submit', function(event){
        event.preventDefault();
        const barcodeValue = document.getElementById('barcodeValue').value;
        const format = document.getElementById('format').value;
        const color = document.getElementById('color').value;

        if(format === "CODE128"){
            if(!/^[a-zA-Z0-9]+$/.test(barcodeValue)){
                error.classList.remove('hidden');
                error.innerText = "Please enter a alphanumeric value!";
                return;
            }
        } else{
            if(!/^\d+$/.test(barcodeValue)){
                error.classList.remove('hidden');
                error.innerText = "Please enter a valid numeric value!";
                return;
            }
        }

        error.classList.add('hidden');
        spinner.classList.remove('hidden');
        barcodeWrapper.classList.add('hidden');
        setTimeout(() => {
            JsBarcode("#barcode", barcodeValue, {
                format: format,
                lineColor: color,
                width: 2,
                height: 50,
                displayValue: true
            });
            spinner.classList.add('hidden');
            barcodeWrapper.classList.remove('hidden');
        }, 500);
    });
    downloadBtn.addEventListener('click', function() {
        const svg = barcodeSvg.outerHTML;
        const svgBlob = new Blob([svg], {type: "image/svg+xml;charset=utf-8"});
        const url = URL.createObjectURL(svgBlob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'barcode.svg';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });
</script>
<style>
    .spinner{
        border: 4px solid rgba(0, 0, 0, 0.1);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border-left-color: #3498db;
    }
    @keyframes spin {
        0%{
            transform: rotate(0deg);
        }
        100%{
            transform: rotate(360deg);
        }
    }
</style>