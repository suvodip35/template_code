<div class="bg-gradient-to-r from-blue-500 via-purple-600 to-pink-500 flex items-center justify-center min-h-screen">
  <div class="bg-white rounded-lg shadow-lg p-6 max-w-md w-full">
    <h1 class="text-3xl font-bold text-purple-700 mb-4 text-center">Slug Generator</h1>
    
    <label for="text-input" class="block text-gray-700 font-semibold mb-2">Enter Text:</label>
    <input
      type="text"
      id="text-input"
      placeholder="Type something here..."
      class="w-full p-3 mb-4 border-2 border-purple-300 rounded-lg focus:border-purple-500 focus:outline-none transition"
    />
    
    <label for="separator" class="block text-gray-700 font-semibold mb-2">Select Separator:</label>
    <select id="separator" class="w-full p-3 mb-4 border-2 border-purple-300 rounded-lg focus:border-purple-500 focus:outline-none transition">
      <option value="-">Dash (-)</option>
      <option value="_">Underscore (_)</option>
      <option value=".">Dot (.)</option>
    </select>

    <label for="case-option" class="block text-gray-700 font-semibold mb-2">Case Option (Premium):</label>
    <select id="case-option" class="w-full p-3 mb-4 border-2 border-purple-300 rounded-lg focus:border-purple-500 focus:outline-none transition">
      <option value="lower">lowercase</option>
      <option value="upper">UPPERCASE</option>
    </select>

    <button
      onclick="generateSlug()"
      class="w-full bg-purple-500 text-white py-3 rounded-lg hover:bg-purple-600 transition duration-200 font-semibold mb-4">
      Generate Slug
    </button>
    
    <div class="bg-gray-50 p-3 rounded-lg border border-gray-200 mb-2">
      <span id="slug-output" class="text-gray-700 font-mono text-lg"></span>
    </div>
    
    <button
      onclick="copyToClipboard()"
      class="w-full bg-green-500 text-white py-3 rounded-lg hover:bg-green-600 transition duration-200 font-semibold">
      Copy to Clipboard
    </button>
    <span id="copy-message" class="text-green-600 text-sm mt-2 block text-center opacity-0 transition-opacity duration-300"></span>
  </div>
</div>
<script is:inline>
    function generateSlug() {
      const textInput = document.getElementById('text-input').value;
      const separator = document.getElementById('separator').value;
      const caseOption = document.getElementById('case-option').value;

      let slug = textInput
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s]/g, '')
        .replace(/\s+/g, separator); 
      
      slug = caseOption === 'upper' ? slug.toUpperCase() : slug.toLowerCase();

      document.getElementById('slug-output').textContent = slug;
    }

    function copyToClipboard() {
      const slugText = document.getElementById('slug-output').textContent;
      navigator.clipboard.writeText(slugText).then(() => {
        const message = document.getElementById('copy-message');
        message.textContent = "Slug copied to clipboard!";
        message.classList.remove("opacity-0");
        message.classList.add("opacity-100");
        
        setTimeout(() => {
          message.classList.remove("opacity-100");
          message.classList.add("opacity-0");
        }, 2000);
      });
    }
</script>
