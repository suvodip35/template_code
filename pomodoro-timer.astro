<div class="bg-gradient-to-br from-slate-950 via-rose-950 to-red-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-rose-200/50 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-orange-200/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-white/95 backdrop-blur-xl p-6 sm:p-8 rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-200/80 relative z-10 text-center">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-rose-200/50 border border-rose-500/30 flex items-center justify-center text-rose-400 text-xl font-bold">🍅</div>
                <div class="text-left">
                    <h2 class="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-orange-300 to-amber-400 tracking-tight">Pomodoro Focus Timer</h2>
                    <p class="text-xs text-slate-500">Boost deep work sessions &amp; productivity</p>
                </div>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 border border-rose-200 font-semibold">FOCUS</span>
        </div>

        <!-- Mode Tabs -->
        <div class="bg-slate-50 p-1.5 rounded-2xl border border-slate-200 flex gap-1 mb-6">
            <button id="tabPomodoro" class="flex-1 py-2 text-xs font-semibold rounded-xl bg-rose-600 text-white shadow-md transition">25:00 Focus</button>
            <button id="tabShortBreak" class="flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition">05:00 Break</button>
            <button id="tabLongBreak" class="flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition">15:00 Long</button>
        </div>

        <!-- Circular Countdown Clock Display -->
        <div class="relative w-52 h-52 mx-auto mb-6 flex items-center justify-center">
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="44" class="text-slate-800/80" stroke-width="6" stroke="currentColor" fill="transparent" />
                <circle id="timerProgress" cx="50" cy="50" r="44" class="text-rose-500" stroke-width="6" stroke-linecap="round" stroke="currentColor" fill="transparent" stroke-dasharray="276.46" stroke-dashoffset="40" />
            </svg>
            <div class="absolute flex flex-col items-center justify-center">
                <span id="timeDisplay" class="font-mono text-4xl sm:text-5xl font-black text-white tracking-tight">25:00</span>
                <span id="sessionLabel" class="text-xs font-mono text-rose-400 font-bold uppercase mt-1">Focus Session #01</span>
            </div>
        </div>

        <!-- Action Row -->
        <div class="flex items-center gap-3">
            <button id="btnDynAction" class="flex-1 bg-gradient-to-r from-rose-500 to-orange-600 hover:from-rose-600 hover:to-orange-700 text-white font-semibold py-3.5 px-4 rounded-xl shadow-lg shadow-rose-500/25 transition active:scale-[0.98] flex items-center justify-center gap-2 text-sm">
                <span id="playIcon">▶</span>
                <span id="playText">Start Timer</span>
            </button>
            <button id="btnDynCopy" class="bg-slate-800 hover:bg-slate-700 text-white font-semibold py-3.5 px-5 rounded-xl border border-slate-200 transition active:scale-[0.98] text-sm">
                Reset
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    let mode = 'pomodoro';
    let totalSeconds = 25 * 60;
    let remaining = totalSeconds;
    let timerId = null;

    const timeDisplay = document.getElementById('timeDisplay');
    const timerProgress = document.getElementById('timerProgress');
    const sessionLabel = document.getElementById('sessionLabel');
    const tabPomodoro = document.getElementById('tabPomodoro');
    const tabShort = document.getElementById('tabShortBreak');
    const tabLong = document.getElementById('tabLongBreak');
    const btnPlay = document.getElementById('btnDynAction');
    const playIcon = document.getElementById('playIcon');
    const playText = document.getElementById('playText');
    const btnReset = document.getElementById('btnDynCopy');

    const CIRCUMFERENCE = 276.46;

    function render() {
        const m = Math.floor(remaining / 60);
        const s = remaining % 60;
        timeDisplay.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        const offset = CIRCUMFERENCE - (remaining / totalSeconds) * CIRCUMFERENCE;
        timerProgress.style.strokeDashoffset = offset;
    }

    function setMode(newMode, dur, label) {
        mode = newMode;
        totalSeconds = dur;
        remaining = dur;
        sessionLabel.textContent = label;
        clearInterval(timerId);
        timerId = null;
        playIcon.textContent = '▶';
        playText.textContent = 'Start Timer';
        btnPlay.classList.remove('bg-amber-600');
        render();
    }

    tabPomodoro.onclick = () => {
        tabPomodoro.className = "flex-1 py-2 text-xs font-semibold rounded-xl bg-rose-600 text-white shadow-md transition";
        tabShort.className = "flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition";
        tabLong.className = "flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition";
        setMode('pomodoro', 25 * 60, 'Focus Session #01');
    };

    tabShort.onclick = () => {
        tabShort.className = "flex-1 py-2 text-xs font-semibold rounded-xl bg-rose-600 text-white shadow-md transition";
        tabPomodoro.className = "flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition";
        tabLong.className = "flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition";
        setMode('short', 5 * 60, 'Short Coffee Break');
    };

    tabLong.onclick = () => {
        tabLong.className = "flex-1 py-2 text-xs font-semibold rounded-xl bg-rose-600 text-white shadow-md transition";
        tabPomodoro.className = "flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition";
        tabShort.className = "flex-1 py-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 transition";
        setMode('long', 15 * 60, 'Long Recharge Break');
    };

    btnPlay.onclick = () => {
        if (timerId) {
            clearInterval(timerId);
            timerId = null;
            playIcon.textContent = '▶';
            playText.textContent = 'Resume';
        } else {
            playIcon.textContent = '⏸';
            playText.textContent = 'Pause';
            timerId = setInterval(() => {
                if (remaining > 0) {
                    remaining--;
                    render();
                } else {
                    clearInterval(timerId);
                    timerId = null;
                    playIcon.textContent = '▶';
                    playText.textContent = 'Finished! ✓';
                }
            }, 1000);
        }
    };

    btnReset.onclick = () => {
        clearInterval(timerId);
        timerId = null;
        remaining = totalSeconds;
        playIcon.textContent = '▶';
        playText.textContent = 'Start Timer';
        render();
    };

    render();
})();
</script>