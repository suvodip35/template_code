<div class="bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-indigo-600/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-cyan-600/25 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md bg-slate-900/90 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl border border-slate-800 relative z-10 transition-all duration-300">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-800 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-indigo-950 border border-indigo-500/40 flex items-center justify-center text-xl font-bold shadow-sm">🎧</div>
                <div>
                    <h2 class="text-xl font-bold text-white tracking-tight">Product Swatch Selector</h2>
                    <p class="text-xs text-slate-400 font-medium">Reactive E-Commerce Color Variant Picker</p>
                </div>
            </div>
            <span id="stockBadge" class="text-xs font-mono px-3 py-1 rounded-full bg-emerald-950/80 text-emerald-300 border border-emerald-500/40 font-semibold shadow-sm">IN STOCK ✓</span>
        </div>

        <!-- Product Preview Box -->
        <div class="bg-slate-950/90 p-6 rounded-2xl border border-slate-800 mb-5 flex flex-col items-center justify-center relative overflow-hidden min-h-[160px]">
            <div id="swatchGlow" class="absolute inset-0 bg-blue-500/15 blur-2xl transition-all duration-500"></div>
            <div id="productHero" class="w-24 h-24 rounded-3xl bg-cyan-500 shadow-2xl border-2 border-white/20 transition-all duration-300 flex items-center justify-center text-3xl font-bold relative z-10">
                🎧
            </div>
            <div class="mt-4 text-center relative z-10">
                <h3 class="text-sm font-bold text-white">Astro ANC Studio Headphones</h3>
                <span id="colorNameLabel" class="text-xs font-mono text-cyan-400 font-semibold">Electric Cyan Edition</span>
            </div>
        </div>

        <!-- Color Swatch Circle Buttons -->
        <div class="mb-5">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2.5">
                <span>Choose Finish:</span>
                <span id="priceTag" class="font-mono text-emerald-400 font-bold text-sm">$249.00</span>
            </div>
            <div class="flex items-center justify-between gap-3 bg-slate-950/60 p-3 rounded-2xl border border-slate-800">
                <button class="swatch-btn w-9 h-9 rounded-full bg-slate-900 border-2 border-slate-600 hover:scale-110 transition active:scale-95" data-color="#0f172a" data-name="Midnight Black"></button>
                <button class="swatch-btn w-9 h-9 rounded-full bg-cyan-500 border-2 border-white ring-2 ring-cyan-400 hover:scale-110 transition active:scale-95 scale-110" data-color="#06b6d4" data-name="Electric Cyan Edition"></button>
                <button class="swatch-btn w-9 h-9 rounded-full bg-purple-600 border-2 border-slate-600 hover:scale-110 transition active:scale-95" data-color="#9333ea" data-name="Deep Violet Edition"></button>
                <button class="swatch-btn w-9 h-9 rounded-full bg-rose-500 border-2 border-slate-600 hover:scale-110 transition active:scale-95" data-color="#f43f5e" data-name="Crimson Red Edition"></button>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button id="btnAddToCart" class="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg transition active:scale-[0.98] text-sm flex items-center justify-center gap-2">
                <span>🛒 Add to Cart</span>
            </button>
            <button id="btnCopySwatch" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-3.5 px-5 rounded-xl border border-slate-700 transition active:scale-[0.98] text-sm">
                Copy SKU
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const hero = document.getElementById('productHero');
    const glow = document.getElementById('swatchGlow');
    const nameLabel = document.getElementById('colorNameLabel');
    const btnAdd = document.getElementById('btnAddToCart');
    const btnCopy = document.getElementById('btnCopySwatch');
    const swatches = document.querySelectorAll('.swatch-btn');

    let activeColor = '#06b6d4';

    swatches.forEach(btn => {
        btn.onclick = () => {
            swatches.forEach(b => {
                b.classList.remove('border-white', 'ring-2', 'ring-cyan-400', 'scale-110');
                b.classList.add('border-slate-600');
            });
            btn.classList.add('border-white', 'ring-2', 'ring-cyan-400', 'scale-110');
            btn.classList.remove('border-slate-600');

            activeColor = btn.dataset.color;
            hero.style.backgroundColor = activeColor;
            glow.style.backgroundColor = activeColor;
            nameLabel.textContent = btn.dataset.name;
        };
    });

    btnAdd.onclick = () => {
        btnAdd.innerHTML = '<span>Added to Cart! ✓</span>';
        btnAdd.classList.add('bg-emerald-600');
        setTimeout(() => {
            btnAdd.innerHTML = '<span>🛒 Add to Cart</span>';
            btnAdd.classList.remove('bg-emerald-600');
        }, 1400);
    };

    btnCopy.onclick = async () => {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(`SKU-ANC-${activeColor.replace('#', '').toUpperCase()}`);
            }
        } catch(e) {}
        btnCopy.textContent = 'Copied! ✓';
        btnCopy.classList.add('bg-emerald-600');
        setTimeout(() => {
            btnCopy.textContent = 'Copy SKU';
            btnCopy.classList.remove('bg-emerald-600');
        }, 1400);
    };
})();
</script>