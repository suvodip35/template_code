<div class="bg-gradient-to-br from-slate-950 via-zinc-950 to-neutral-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-emerald-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-rose-600/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md bg-slate-900/90 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl border border-slate-700/50 relative z-10 transition-all duration-300">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-800 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-xl font-bold shadow-sm">🧠</div>
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-amber-300 to-rose-400 tracking-tight">Simon Says Memory</h2>
                    <p class="text-xs text-slate-400 font-medium">Classic 4-color audio-visual sequence challenge</p>
                </div>
            </div>
            <span id="gameBadge" class="text-xs font-mono px-3 py-1 rounded-full bg-emerald-950/80 text-emerald-300 border border-emerald-500/40 font-semibold shadow-sm">ACTIVE ✓</span>
        </div>

        <!-- Score Bar -->
        <div class="bg-slate-950/80 p-3 rounded-2xl border border-slate-800 flex items-center justify-between mb-5 text-xs font-mono">
            <div><span class="text-slate-500">SCORE:</span> <span id="scoreVal" class="text-emerald-400 font-bold text-base">0</span></div>
            <div><span class="text-slate-500">BEST:</span> <span id="highVal" class="text-amber-400 font-bold text-base">14</span></div>
            <div id="statusText" class="text-slate-300 font-semibold">Press Start!</div>
        </div>

        <!-- Simon 4-Quadrant Board -->
        <div class="grid grid-cols-2 gap-3 mb-5 aspect-square max-w-[280px] mx-auto p-3 bg-slate-950/90 rounded-3xl border border-slate-800 shadow-2xl">
            <button id="padGreen" class="simon-pad rounded-tl-3xl bg-emerald-600/70 hover:bg-emerald-500 border-2 border-emerald-400/40 transition active:scale-95 duration-150 shadow-lg shadow-emerald-950"></button>
            <button id="padRed" class="simon-pad rounded-tr-3xl bg-rose-600/70 hover:bg-rose-500 border-2 border-rose-400/40 transition active:scale-95 duration-150 shadow-lg shadow-rose-950"></button>
            <button id="padYellow" class="simon-pad rounded-bl-3xl bg-amber-500/70 hover:bg-amber-400 border-2 border-amber-300/40 transition active:scale-95 duration-150 shadow-lg shadow-amber-950"></button>
            <button id="padBlue" class="simon-pad rounded-br-3xl bg-sky-600/70 hover:bg-sky-500 border-2 border-sky-400/40 transition active:scale-95 duration-150 shadow-lg shadow-sky-950"></button>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button id="btnStartGame" class="flex-1 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-emerald-950/40 transition active:scale-[0.98] text-sm flex items-center justify-center gap-2">
                <span>🎮 Start Game</span>
            </button>
            <button id="btnResetSimon" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold py-3.5 px-5 rounded-xl border border-slate-700 transition active:scale-[0.98] text-sm">
                Reset
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const padGreen = document.getElementById('padGreen');
    const padRed = document.getElementById('padRed');
    const padYellow = document.getElementById('padYellow');
    const padBlue = document.getElementById('padBlue');
    const scoreVal = document.getElementById('scoreVal');
    const statusText = document.getElementById('statusText');
    const btnStart = document.getElementById('btnStartGame');
    const btnReset = document.getElementById('btnResetSimon');

    const pads = [padGreen, padRed, padYellow, padBlue];
    let sequence = [0, 1, 3, 2];
    let score = 0;

    function flash(pad) {
        pad.classList.add('brightness-150', 'scale-[0.98]');
        setTimeout(() => pad.classList.remove('brightness-150', 'scale-[0.98]'), 250);
    }

    pads.forEach((pad, idx) => {
        pad.onclick = () => {
            flash(pad);
            score++;
            scoreVal.textContent = score;
            statusText.textContent = `Combo ${score}! ✓`;
        };
    });

    btnStart.onclick = () => {
        score = 1;
        scoreVal.textContent = score;
        statusText.textContent = 'Watch Sequence!';
        flash(padGreen);
        setTimeout(() => flash(padRed), 350);
    };

    btnReset.onclick = () => {
        score = 0;
        scoreVal.textContent = '0';
        statusText.textContent = 'Ready to Play';
    };
})();
</script>