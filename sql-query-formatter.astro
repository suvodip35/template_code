<div class="bg-gradient-to-br from-slate-950 via-blue-950 to-indigo-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-600/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-600/25 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-slate-900/90 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl shadow-blue-950/70 border border-blue-500/35 relative z-10 transition-all duration-300">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-800/80 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-blue-950/80 border border-blue-500/40 flex items-center justify-center text-blue-400 font-mono text-xl font-bold shadow-sm">SQL</div>
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-indigo-300 tracking-tight">SQL Query Formatter</h2>
                    <p class="text-xs text-slate-400 font-medium">Beautify, indent clauses, and uppercase SQL keywords</p>
                </div>
            </div>
            <span id="sqlStatus" class="text-xs font-mono px-3 py-1 rounded-full bg-blue-950/80 text-blue-300 border border-blue-500/40 font-semibold shadow-sm">VALID SQL ✓</span>
        </div>

        <!-- Mode Toolbar -->
        <div class="grid grid-cols-3 gap-2 mb-4 text-xs font-semibold">
            <button id="btnFormatSQL" class="py-2.5 px-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white rounded-xl font-bold shadow-md shadow-blue-500/30 transition active:scale-95 flex items-center justify-center gap-1.5">
                <span>✨ Format &amp; Indent</span>
            </button>
            <button id="btnMinifySQL" class="py-2.5 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl font-bold border border-slate-700 transition active:scale-95 flex items-center justify-center gap-1.5">
                <span>⚡ 1-Line Minify</span>
            </button>
            <button id="btnUppercaseSQL" class="py-2.5 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl font-bold border border-slate-700 transition active:scale-95 flex items-center justify-center gap-1.5">
                <span>🔠 UPPERCASE</span>
            </button>
        </div>

        <!-- Raw SQL Input -->
        <div class="mb-4">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2">
                <span>Raw Unformatted Query:</span>
                <span id="rawStats" class="font-mono text-blue-400 font-bold bg-blue-950/60 px-2.5 py-0.5 rounded-md border border-blue-800/60">178 chars</span>
            </div>
            <textarea id="sqlInput" rows="3" class="w-full bg-slate-950/80 border border-slate-800 rounded-2xl p-3 text-xs sm:text-sm font-mono text-slate-200 focus:outline-none focus:border-blue-500 transition resize-none leading-relaxed select-text">select u.id, u.name, u.email, o.total_amount, o.status, o.created_at from users u inner join orders o on u.id = o.user_id where o.status = 'completed' and o.total_amount >= 199.99 order by o.created_at desc limit 25;</textarea>
        </div>

        <!-- Formatted Clean SQL Output -->
        <div class="mb-5">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2">
                <span>Formatted Result:</span>
                <span id="formatStats" class="font-mono text-emerald-400 font-bold bg-emerald-950/60 px-2.5 py-0.5 rounded-md border border-emerald-800/60">12 lines • 2-space indent</span>
            </div>
            <textarea id="sqlOutput" rows="7" readonly class="w-full bg-slate-950/95 border border-blue-900/50 rounded-2xl p-3 text-xs sm:text-sm font-mono text-cyan-300 focus:outline-none resize-none leading-relaxed select-text shadow-inner"></textarea>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button id="btnCopySQL" class="flex-1 bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 hover:from-emerald-600 hover:to-cyan-600 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-emerald-950/40 transition active:scale-[0.98] text-sm flex items-center justify-center gap-2">
                <span>📋 Copy Formatted SQL</span>
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const input = document.getElementById('sqlInput');
    const output = document.getElementById('sqlOutput');
    const rawStats = document.getElementById('rawStats');
    const formatStats = document.getElementById('formatStats');
    const btnFormat = document.getElementById('btnFormatSQL');
    const btnMinify = document.getElementById('btnMinifySQL');
    const btnUpper = document.getElementById('btnUppercaseSQL');
    const btnCopy = document.getElementById('btnCopySQL');

    const keywords = [
        "SELECT", "FROM", "WHERE", "INNER JOIN", "LEFT JOIN", "RIGHT JOIN", 
        "JOIN", "ON", "ORDER BY", "GROUP BY", "HAVING", "LIMIT", "OFFSET", 
        "VALUES", "INSERT INTO", "UPDATE", "SET", "DELETE FROM", "UNION ALL", "UNION",
        "AND", "OR", "ASC", "DESC", "IN", "NOT IN", "IS NULL", "IS NOT NULL"
    ];

    function formatSQL() {
        let q = input.value.trim();
        if (!q) { output.value = ''; return; }
        rawStats.textContent = `${q.length} chars`;

        q = q.replace(/\s+/g, ' ');

        keywords.forEach(kw => {
            const re = new RegExp('\\b' + kw + '\\b', 'gi');
            q = q.replace(re, kw);
        });

        const majorClauses = ["SELECT", "FROM", "WHERE", "INNER JOIN", "LEFT JOIN", "RIGHT JOIN", "JOIN", "ORDER BY", "GROUP BY", "HAVING", "LIMIT", "SET", "VALUES"];
        majorClauses.forEach(cl => {
            const re = new RegExp('\\b(' + cl + ')\\b', 'g');
            q = q.replace(re, '\n$1');
        });

        q = q.replace(/\b(AND|OR)\b/g, '\n  $1');
        q = q.replace(/SELECT\s+/g, 'SELECT\n  ');
        q = q.replace(/,\s*/g, ',\n  ');

        const lines = q.split('\n').map(l => l.trimRight()).filter(l => l.length > 0);
        output.value = lines.join('\n');
        formatStats.textContent = `${lines.length} lines • formatted ✓`;
    }

    function minifySQL() {
        let q = input.value.trim().replace(/\s+/g, ' ');
        keywords.forEach(kw => {
            const re = new RegExp('\\b' + kw + '\\b', 'gi');
            q = q.replace(re, kw);
        });
        output.value = q;
        formatStats.textContent = `1 line • minified (${q.length} chars)`;
    }

    btnFormat.onclick = () => {
        formatSQL();
        btnFormat.className = "py-2.5 px-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl font-bold shadow-md shadow-blue-500/30 transition active:scale-95 flex items-center justify-center gap-1.5";
        btnMinify.className = "py-2.5 px-3 bg-slate-800 text-slate-300 rounded-xl font-bold border border-slate-700 transition active:scale-95 flex items-center justify-center gap-1.5";
    };

    btnMinify.onclick = () => {
        minifySQL();
        btnMinify.className = "py-2.5 px-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl font-bold shadow-md shadow-blue-500/30 transition active:scale-95 flex items-center justify-center gap-1.5";
        btnFormat.className = "py-2.5 px-3 bg-slate-800 text-slate-300 rounded-xl font-bold border border-slate-700 transition active:scale-95 flex items-center justify-center gap-1.5";
    };

    btnUpper.onclick = () => {
        let q = output.value || input.value;
        keywords.forEach(kw => {
            const re = new RegExp('\\b' + kw + '\\b', 'gi');
            q = q.replace(re, kw);
        });
        output.value = q;
    };

    btnCopy.onclick = async () => {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(output.value);
            }
        } catch (e) {}
        btnCopy.innerHTML = '<span>Copied! ✓</span>';
        btnCopy.classList.add('bg-emerald-600');
        setTimeout(() => {
            btnCopy.innerHTML = '<span>📋 Copy Formatted SQL</span>';
            btnCopy.classList.remove('bg-emerald-600');
        }, 1400);
    };

    input.addEventListener('input', formatSQL);
    formatSQL();
})();
</script>