<div class="bg-gradient-to-r from-purple-500 to-blue-500 flex items-center
    justify-center h-screen flex-col">
    <div class="bg-white rounded-lg shadow-lg p-6 max-w-xl w-full text-center">
        <h2
            class="text-2xl font-semibold mb-4 text-gray-800">
            Rate Our Service
        </h2>
        <div
            class="flex space-x-2 mb-4 justify-center">
            <span
                class="star cursor-pointer text-gray-300" data-value="1">&#9733;
            </span>
            <span
                class="star cursor-pointer text-gray-300" data-value="2">&#9733;
            </span>
            <span
                class="star cursor-pointer text-gray-300" data-value="3">&#9733;
            </span>
            <span
                class="star cursor-pointer text-gray-300" data-value="4">&#9733;
            </span>
            <span
                class="star cursor-pointer text-gray-300" data-value="5">&#9733;
            </span>
        </div>
        <p
            id="ratingMessage"
            class="text-gray-700 text-lg">
        </p>
    </div>
</div>
<script is:inline>
    const stars = document.querySelectorAll('.star');
    const ratingMessage = document.getElementById('ratingMessage');
    let rating = 0;

    stars.forEach(star => {
        star.addEventListener('mouseover', () => {
            updateStars(star.getAttribute('data-value'));
        });
        star.addEventListener('click', () => {
            rating = star.getAttribute('data-value');
            updateStars(rating);
            ratingMessage.textContent = `You rated this ${rating} star${rating > 1 ? 's' : ''}.`;
        });

        star.addEventListener('mouseleave', () => {
            updateStars(rating);
        });
    });
    function updateStars(rating){
        stars.forEach(star => {
            star.classList.remove('selected');
            if(star.getAttribute('data-value') <= rating){
                star.classList.add('selected')
            }
        })
    }
</script>

<style>
    .star{
        font-size: 5rem;
        transition: transform 0.2s, color 0.2s;
    }
    .star:hover{
        color: #fbbf24;
        transform: scale(1.2);
    }
    .star.selected{
        color: #fbbf24;
    }
</style>