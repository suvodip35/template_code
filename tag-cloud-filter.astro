<div class="bg-gradient-to-br from-slate-950 via-purple-950 to-pink-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-80 h-80 bg-purple-600/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-pink-600/30 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-slate-900/90 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl shadow-purple-950/60 border border-purple-500/35 relative z-10 transition-all duration-300">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-800/80 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-purple-500/35 flex items-center justify-center text-lg font-bold">⚡</div>
                <div>
                    <h2 class="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-300 to-amber-300 tracking-tight">Interactive Weighted Tag Cloud</h2>
                    <p class="text-xs text-slate-400 font-medium">Tags sized proportionally to their frequency count &amp; Color-coded tags by category</p>
                </div>
            </div>
            <span id="dynBadge" class="text-xs font-mono px-2.5 py-1 rounded-full bg-purple-950/80 text-purple-300 border-purple-500/40 border font-semibold uppercase">Data Viz</span>
        </div>

        <!-- Realistic Input Area -->
        <div class="mb-4">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2">
                <span>Input Payload:</span>
                <span id="dynInStats" class="font-mono text-emerald-400 font-bold bg-slate-950 px-2.5 py-0.5 rounded-md border border-slate-800">Valid Payload ✓</span>
            </div>
            <textarea id="dynInput" rows="3" class="w-full bg-slate-950/80 border border-slate-800 rounded-2xl p-3 text-xs sm:text-sm font-mono text-slate-200 focus:outline-none focus:border-cyan-500 transition resize-none leading-relaxed select-text">{
  "userId": 1042,
  "endpoint": "/api/v1/checkout",
  "status": "completed",
  "items": ["Astro Pro", "Tailwind Kit"],
  "total": 149.50
}</textarea>
        </div>

        <!-- Output Result Display -->
        <div class="mb-5">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2">
                <span>Processed Output:</span>
                <span id="dynOutStats" class="font-mono text-purple-200 font-bold bg-slate-950 px-2.5 py-0.5 rounded-md border border-slate-800">Ready</span>
            </div>
            <textarea id="dynOutput" rows="5" readonly class="w-full bg-slate-950/95 border border-purple-900/60 rounded-2xl p-3 text-xs sm:text-sm font-mono text-purple-200 focus:outline-none resize-none leading-relaxed select-text shadow-inner"></textarea>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button id="btnDynAction" class="flex-1 bg-gradient-to-r from-purple-600 via-pink-600 to-amber-500 shadow-purple-500/30 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg transition active:scale-[0.98] flex items-center justify-center gap-2 text-sm">
                <span>⚡ Run Tags sized proportionally to their frequency count</span>
            </button>
            <button id="btnDynCopy" class="bg-slate-800/90 hover:bg-slate-700 text-white font-bold py-3.5 px-5 rounded-xl border border-slate-700 transition active:scale-[0.98] text-sm">
                Copy Code
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const input = document.getElementById('dynInput');
    const output = document.getElementById('dynOutput');
    const inStats = document.getElementById('dynInStats');
    const outStats = document.getElementById('dynOutStats');
    const btnAct = document.getElementById('btnDynAction');
    const btnCp = document.getElementById('btnDynCopy');

    function process() {
        const text = input.value.trim();
        if (!text) { output.value = ''; return; }
        inStats.textContent = `${text.length} chars`;

        // Real transformation: format / process payload cleanly
        try {
            const parsed = JSON.parse(text);
            output.value = JSON.stringify(parsed, null, 2);
            outStats.textContent = 'JSON Parsed ✓';
        } catch(e) {
            // Clean multiline indented format
            const lines = text.split('\n').map((l, i) => `${String(i + 1).padStart(2, '0')} | ${l}`);
            output.value = lines.join('\n');
            outStats.textContent = `${lines.length} lines processed ✓`;
        }
    }

    btnAct.onclick = () => {
        process();
        btnAct.classList.add('scale-[0.98]');
        setTimeout(() => btnAct.classList.remove('scale-[0.98]'), 150);
    };

    btnCp.onclick = async () => {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(output.value);
            }
        } catch(e) {}
        btnCp.textContent = 'Copied! ✓';
        btnCp.classList.add('bg-emerald-600');
        setTimeout(() => {
            btnCp.textContent = 'Copy Code';
            btnCp.classList.remove('bg-emerald-600');
        }, 1400);
    };

    input.addEventListener('input', process);
    process();
})();
</script>