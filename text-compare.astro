<div class="bg-gradient-to-br from-red-500 via-purple-500 to-pink-500 min-h-screen flex items-center justify-center">
    <div class="bg-white bg-opacity-95 max-w-lg w-full p-8 rounded-lg shadow-xl">
        <h1 class="text-2xl font-bold text-center text-indigo-600 mb-6">
            Text Difference Checker
        </h1>
        <div class="mb-4">
            <label
                for="text1"
                class="block text-lg font-medium text-gray-700">
                Enter First Text:
            </label>
            <textarea
                id="text1"
                rows="5"
                class="w-full p-4 mt-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600"
                placeholder="Enter the first block of text"
            ></textarea>
        </div>
        <div class="mb-4">
            <label
                for="text2"
                class="block text-lg font-medium text-gray-700">
                Enter Second Text:
            </label>
            <textarea
                id="text2"
                rows="5"
                class="w-full p-4 mt-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600"
                placeholder="Enter the second block of text"
            ></textarea>
        </div>
        <div class="flex justify-between items-center mb-4">
            <button onclick="compareTexts()" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition duration-300">
                Compare Texts
            </button>
            <button onclick="clearFields()" class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg transition duration-300">
                Clear
            </button>
        </div>
        <div class="mt-4">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">
                Differences:
            </h2>
            <div id="output" class="border p-4 rounded-lg bg-gray-50 min-h-[150px]"></div>
        </div>
        <div id="summary" class="flex justify-between mt-4 text-gray-700">
            <p>
                Total Lines Compared: <span id="totalLines"></span>
            </p>
            <p>
                Differences Found: <span id="differencesCount"></span>
            </p>
        </div>
        <div class="mt-4 text-center">
            <button onclick="copyOutput()" class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition duration-300">
                Copy Output
            </button>
        </div>
        <div id="statusMessage" class="mt-4 text-center text-sm text-gray-600"></div>
    </div>
</div>
<script is:inline>
    function compareTexts(){
        const text1 = document.getElementById('text1').value.split("\n");
        const text2 = document.getElementById('text2').value.split("\n");

        let output = '';
        let differencesFound = false;
        let lineDifferences = 0;
        let totalLines = Math.max(text1.length, text2.length);

        for(let i = 0; i < totalLines; i++){
            const line1 = text1[i] || '';
            const line2 = text2[i] || '';

            if(line1 === line2){
                output += `<p class="text-gray-700">${line1}</p>`;
            } else{
                differencesFound = true;
                lineDifferences++;

                output += `<p class="mb-2">`;
                output += compareLineWords(line1, line2);
                output += `</p>`;
            }
        }

        document.getElementById('output').innerHTML = output;
        
        const statusMessage = document.getElementById('statusMessage');
        if(differencesFound){
            statusMessage.innerHTML = `<span class="text-green-600 font-semibold">Differences found and highlighted!</span>`;
        }else{
            statusMessage.innerHTML = `<span class="text-yellow-600 font-semibold">Differences detected!</span>`;
        }

        document.getElementById('totalLines').textContent = totalLines;
        document.getElementById('differencesCount').textContent = lineDifferences;
    }

    function compareLineWords(line1, line2){
        let result = '';
        const words1 = line1.split(/\s+/);
        const words2 = line2.split(/\s+/);

        const maxLength = Math.max(words1.length, words2.length);
        for(let i = 0; i < maxLength; i++){
            const word1 = words1[i] || '';
            const word2 = words2[i] || '';

            if(word1 === word2){
                result += `${word1}`;
            } else{
                if(word1){
                    result += `<span class="bg-red-100 text-red-700 p-1 rounded">${word1}</span>`;
                }
                if(word2){
                    result +=  `<span class="bg-green-100 text-green-700 p-1 rounded">${word2}</span>`;
                }
            }
        }
        return result;
    }

    function clearFields(){
        document.getElementById('text1').value = '';
        document.getElementById('text2').value = '';
        document.getElementById('output').innerHTML = '';
        document.getElementById('statusMessage').innerHTML = '';
        document.getElementById('summary').style.display = 'none';
    }

    function copyOutput(){
        const outputText = document.getElementById('output').innerText;
        if(outputText){
            navigator.clipboard.writeText(outputText).then(() => {
                document.getElementById('statusMessage').innerHTML = '<span class="text-green-600 font-semibold">Output copied to clipboard!</span>';
            });
        } else{
            document.getElementById('statusMessage').innerHTML = '<span class="text-red-600 font-semibold">No differences to copy!</span>';
        }
    }
</script>