<div class="bg-gradient-to-br from-slate-950 via-purple-950 to-indigo-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden font-sans">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-purple-600/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-600/25 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl bg-slate-900/90 backdrop-blur-2xl p-6 sm:p-8 rounded-3xl shadow-2xl shadow-purple-950/70 border border-purple-500/35 relative z-10 transition-all duration-300">
        <!-- Header -->
        <div class="flex items-center justify-between mb-5 border-b border-slate-800/80 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-purple-950/80 border border-purple-500/40 flex items-center justify-center text-purple-400 font-mono text-xl font-bold shadow-sm">⏱️</div>
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-300 to-indigo-300 tracking-tight">Unix Timestamp Converter</h2>
                    <p class="text-xs text-slate-400 font-medium">Parse epoch seconds to UTC, ISO 8601 &amp; human date</p>
                </div>
            </div>
            <span id="epochStatus" class="text-xs font-mono px-3 py-1 rounded-full bg-purple-950/80 text-purple-300 border border-purple-500/40 font-semibold shadow-sm">EPOCH SECONDS ✓</span>
        </div>

        <!-- Quick Presets -->
        <div class="grid grid-cols-3 gap-2 mb-4 text-xs font-semibold">
            <button id="btnEpochNow" class="py-2.5 px-3 bg-purple-600 hover:bg-purple-500 text-white rounded-xl font-bold shadow-md shadow-purple-500/30 transition active:scale-95 flex items-center justify-center gap-1.5">
                <span>⏱️ Current Timestamp</span>
            </button>
            <button id="btnPlusHour" class="py-2.5 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl font-bold border border-slate-700 transition active:scale-95">
                +1 Hour
            </button>
            <button id="btnPlusDay" class="py-2.5 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl font-bold border border-slate-700 transition active:scale-95">
                +1 Day
            </button>
        </div>

        <!-- Input Box -->
        <div class="mb-4">
            <label class="block text-xs font-semibold text-slate-400 mb-2">Unix Timestamp (Seconds or Milliseconds):</label>
            <div class="flex gap-2">
                <input id="epochInput" type="text" value="1730304000" class="flex-1 bg-slate-950/80 border border-slate-800 rounded-2xl px-4 py-3 text-sm sm:text-base font-mono text-purple-200 focus:outline-none focus:border-purple-500 transition select-text" />
                <button id="btnConvertEpoch" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold px-5 rounded-2xl transition active:scale-95 text-xs shadow-md shadow-purple-900/40">
                    Convert
                </button>
            </div>
        </div>

        <!-- Converted Output Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5 text-xs">
            <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-slate-800">
                <span class="text-slate-500 block mb-1 text-[11px] font-semibold uppercase">UTC Format</span>
                <span id="outUTC" class="font-mono text-purple-300 font-bold break-all">Fri, 30 Oct 2026 16:00:00 GMT</span>
            </div>
            <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-slate-800">
                <span class="text-slate-500 block mb-1 text-[11px] font-semibold uppercase">ISO 8601</span>
                <span id="outISO" class="font-mono text-cyan-300 font-bold break-all">2026-10-30T16:00:00.000Z</span>
            </div>
            <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-slate-800">
                <span class="text-slate-500 block mb-1 text-[11px] font-semibold uppercase">Local Timezone</span>
                <span id="outLocal" class="font-mono text-emerald-300 font-bold break-all">Fri Oct 30 2026 21:30:00</span>
            </div>
            <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-slate-800">
                <span class="text-slate-500 block mb-1 text-[11px] font-semibold uppercase">Relative Time</span>
                <span id="outRelative" class="font-mono text-amber-300 font-bold break-all">Active Epoch</span>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button id="btnCopyEpoch" class="flex-1 bg-gradient-to-r from-purple-600 via-pink-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-purple-950/40 transition active:scale-[0.98] text-sm flex items-center justify-center gap-2">
                <span>📋 Copy ISO Date</span>
            </button>
        </div>
    </div>
</div>

<script is:inline>
(function() {
    const input = document.getElementById('epochInput');
    const outUTC = document.getElementById('outUTC');
    const outISO = document.getElementById('outISO');
    const outLocal = document.getElementById('outLocal');
    const outRelative = document.getElementById('outRelative');
    const btnNow = document.getElementById('btnEpochNow');
    const btnPlusHour = document.getElementById('btnPlusHour');
    const btnPlusDay = document.getElementById('btnPlusDay');
    const btnConvert = document.getElementById('btnConvertEpoch');
    const btnCopy = document.getElementById('btnCopyEpoch');

    function update() {
        let val = input.value.trim();
        let num = parseInt(val, 10);
        if (isNaN(num)) num = Math.floor(Date.now() / 1000);

        const ms = num < 10000000000 ? num * 1000 : num;
        const d = new Date(ms);

        outUTC.textContent = d.toUTCString();
        outISO.textContent = d.toISOString();
        outLocal.textContent = d.toLocaleString();

        const diffSec = Math.round((Date.now() - ms) / 1000);
        if (Math.abs(diffSec) < 60) {
            outRelative.textContent = 'Just now • Active epoch';
        } else if (diffSec > 0) {
            outRelative.textContent = `${Math.floor(diffSec / 60)} minutes ago`;
        } else {
            outRelative.textContent = `In ${Math.floor(Math.abs(diffSec) / 60)} minutes`;
        }
    }

    btnNow.onclick = () => {
        input.value = Math.floor(Date.now() / 1000);
        update();
    };

    btnPlusHour.onclick = () => {
        let num = parseInt(input.value, 10) || Math.floor(Date.now() / 1000);
        input.value = num + 3600;
        update();
    };

    btnPlusDay.onclick = () => {
        let num = parseInt(input.value, 10) || Math.floor(Date.now() / 1000);
        input.value = num + 86400;
        update();
    };

    btnConvert.onclick = update;
    input.addEventListener('input', update);

    btnCopy.onclick = async () => {
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(outISO.textContent);
            }
        } catch (e) {}
        btnCopy.innerHTML = '<span>Copied! ✓</span>';
        btnCopy.classList.add('bg-emerald-600');
        setTimeout(() => {
            btnCopy.innerHTML = '<span>📋 Copy ISO Date</span>';
            btnCopy.classList.remove('bg-emerald-600');
        }, 1400);
    };

    update();
})();
</script>