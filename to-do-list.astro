<div 
    class="flex items-center justify-center min-h-screen
    bg-gradient-to-r from-teal-400 to-blue-500">
    <div 
        class="w-full max-w-lg p-6 bg-white rounded-2xl shadow-2xl">
        <h2
            class="text-3xl font-bold mb-6 text-center text-gray-800">
            To-Do List
        </h2>
        <div 
            class="flex mb-4">
            <input 
            type="text"
            name="" 
            id="taskInput"
            placeholder="Add a new task" 
            class="flex-grow p-3 border-2 rounded-l-lg focus:outline-none
            focus:ring-2 focus:ring-blue-400 transition duration-300 ease-in-out"/>
                <button
                onclick="addTask()"
                class="bg-blue-500 text-white px-6 rounded-r-lg hover:bg-blue-600
                transition duration-300 ease-in-out">
                Add
            </button>
        </div>
        <ul
            id="taskList"
            class="list-none space-y-4">
        </ul>
    </div>
</div>
<script is:inline>
    document.addEventListener('DOMContentLoaded', loadTasks);

    function loadTasks(){
        const taskList = document.getElementById('taskInput');
        const tasks = JSON.parse(localStorage.getItem('tasks')) || [];

        tasks.forEach(task => {
            const listItem = createTaskItem(task.text, task.date);
            taskList.appendChild(listItem);
        })
    }

    function addTask(){
        const taskInput = document.getElementById('taskInput');
        const taskList = document.getElementById('taskList');
        const currentDate = new Date().toLocaleString();

        if(taskInput.value.trim() !== ''){
            const listItem = createTaskItem(taskInput.value, currentDate);
            listItem.classList.add('fade-enter');
            taskList.appendChild(listItem);

            setTimeout(() => {
                listItem.classList.remove('fade-enter');
                listItem.classList.add('fade-enter-active');
            }, 10);

            saveTask(taskInput.value, currentDate);
            taskInput.value = '';
        }
    }

    function createTaskItem( task, date){
        const listItem = document.createElement('li');

        listItem.className = `flex justify-between items-center p-4 bg-gray-50 rounded-lg 
        shadow-md transform transition duration-300 ease-in-out`;
        const taskContent = document.createElement('div');
        const taskText = document.createElement('span');
        taskText.textContent = task;
        taskText.className = `block text-gray-800 font-medium`;
        taskContent.appendChild(taskText);

        const taskDate = document.createElement('span');
        taskDate.textContent = `Added on ${date}`;
        taskContent.appendChild(taskDate);

        listItem.appendChild(taskContent);

        const deleteButton = document.createElement('button');
        deleteButton.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>`;
        deleteButton.className = `text-red-500 hover:text-red-700 transition duration-300 ease-in-out`;
        deleteButton.onclick = () => {
            listItem.classList.add('fade-leave');
            setTimeout(() => {
                taskList.removeChild(listItem);
                removeTask(task);
            })
        };
        listItem.appendChild(deleteButton);
        return listItem;
    }

    function saveTask(task, date){
        const tasks = JSON.parse(localStorage.getItem('tasks')) || [];
        tasks.push({text: task, date: date});
        localStorage.setItem('tasks', JSON.stringify(tasks));
    }

    function removeTask(task){
        let tasks = JSON.parse(localStorage.getItem('tasks')) || [];
        tasks = tasks.filter(t => t.text !== task);
        localStorage.setItem('tasks', JSON.stringify(tasks));
    }
</script>
<style>
    .fade-enter{
        opacity: 0;
        transform: translateY(-20px);
    }
    .fade-enter.active{
        opacity: 1;
        transform: translateY(0);
        transform: opacity 0.3s ease-out, transform 0.3s ease-out;
    }
    .fade-leave{
        opacity: 1;
        transform: translateY(0);
    }
    .fade-leave-active{
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.3s ease-out, transform 0.3s ease-out;
    }
</style>