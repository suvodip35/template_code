<div class="bg-gradient-to-r from-blue-400 via-purple-500 to-pink-500 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white shadow-2xl rounded-lg p-6 max-w-lg w-full">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">
            &#127760; Language Translator
        </h1>
        <div class="space-y-4">
            <textarea 
                id="inputText"
                placeholder="Type something to translate..."
                class="w-full p-4 text-gray-700 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-md"
            ></textarea>
            <p id="errorMessage" class="text-red-500 text-sm hidden">
                Please enter text to translate!
            </p>
            <div class="flex items-center gap-4">
                <select
                    id="sourceLang"
                    class="w-full p-3 text-gray-700 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white shadow-sm hover:bg-blue-100">
                    <option value="en">English</option>
                    <option value="es">Spanish</option>
                    <option value="fr">French</option>
                    <option value="de">German</option>
                    <option value="zh">Chinese</option>
                    <option value="bn">Bengali</option>
                </select>
                <button
                    id="swapLangs"
                    class="text-xl bg-gray-200 p-2 rounded-lg shadow-md hover:bg-gray-300">
                    &#8646;
                </button>
                <select
                    id="targetLang"
                    class="w-full p-3 text-gray-700 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white shadow-sm hover:bg-blue-100">
                    <option value="en">English</option>
                    <option value="es">Spanish</option>
                    <option value="fr">French</option>
                    <option value="de">German</option>
                    <option value="zh">Chinese</option>
                    <option value="bn">Bengali</option>
                </select>
            </div>
            <div id="outputSection" class="hidden">
                <h2 class="text-lg font-semibold text-gray-800">
                    Translation:
                </h2>
                <p id="outputText" class="bg-gray-100 rounded-lg border border-gray-300 text-gray-700 shadow-inner p-4"></p>
                <div id="copyMessage" class="text-green-500 text-sm hidden">
                    Copied to clipboard!
                </div>
                <div class="flex justify-end gap-4 mt-2">
                    <button
                        id="copyText"
                        class="px-4 py-2 bg-green-500 text-white rounded-lg shadow-md hover:bg-green-600">
                        &#128203; Copy
                    </button>
                </div>
            </div>
            <div class="flex gap-4">
                <button
                    id="clearInput"
                    class="w-full py-2 bg-red-500 text-white rounded-lg shadow-md hover:bg-red-600">
                    &#128465; Clear
                </button>
            </div>
        </div>
    </div>
</div>
<script is:inline>
    const inputText = document.getElementById('inputText');
    const sourceLang = document.getElementById('sourceLang');
    const targetLang = document.getElementById('targetLang');
    const outputSection = document.getElementById('outputSection');
    const outputText = document.getElementById('outputText');
    const errorMessage = document.getElementById('errorMessage');
    const copyMessage = document.getElementById('copyMessage');
    const swapLangs = document.getElementById('swapLangs');
    const copyText = document.getElementById('copyText');
    const clearInput = document.getElementById('clearInput');

    async function translateTextApi(text, sourceLang, targetLang){
        const cleanedText = text.replace(/\s+/g, ' ').replace(/[\.\!\?]+/g, '. ').trim();
        const response = await fetch(`https://translate.googleapis.com/translate_a/single?client=gtx&sl=${sourceLang}&tl=${targetLang}&dt=t&q=${encodeURIComponent(cleanedText)}`)
        const result = await response.json();
        return result[0][0][0];
    }

    async function translateText(){
        const text = inputText.value.trim();
        if(!text){
            errorMessage.classList.remove('hidden');
            outputSection.classList.add('hidden');
            return;
        }
        errorMessage.classList.add('hidden');
        const source = sourceLang.value;
        const target = targetLang.value;

        try{
            const translatedText = await translateTextApi(text, source, target);
            outputText.textContent = translatedText;
            outputSection.classList.remove('hidden');
        } catch(error){
            outputText.textContent = 'An error occurred: ' + error.message;
            outputSection.classList.remove('hidden');
        }
    }
    inputText.addEventListener('input', translateText);
    sourceLang.addEventListener('change', translateText);
    targetLang.addEventListener('change', translateText);
    swapLangs.addEventListener('click', () => {
        const temp = sourceLang.value;
        sourceLang.value = targetLang.value;
        targetLang.value = temp;
        translateText();
    });
    copyText.addEventListener('click', () => {
        navigator.clipboard.writeText(outputText.textContent)
        .then(() => {
            copyMessage.classList.remove('hidden');
            setTimeout(() => copyMessage.classList.add('hidden'), 2000);
        });
    });
    clearInput.addEventListener('click', () => {
        inputText.value = '';
        outputSection.classList.add('hidden');
    });
</script>