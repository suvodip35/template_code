<div class="min-h-screen flex items-center justify-center bg-gradient-to-r from-blue-500 to-purple-500 p-4">
    <div class="bg-white shadow-xl rounded-lg p-6 max-w-lg w-full ">
        <h2 class="text-2xl font-bold text-center text-gray-800 mb-4">
            XML to JSON Converter
        </h2>
        <textarea 
            id="xmlInput"
            class="w-full h-40 p-3 border rounded-lg focus:ring-2 focus:ring-blue-400"
            placeholder="Paste XML here..."
        ></textarea>
        <p id="errorMessage" class="text-red-500 mt-2 text-sm hidden"></p>
        <div class="flex space-x-2 mt-4">
            <button
                onclick="convertXML()"
                class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
                Convert
            </button>
            <button
                onclick="clearFields()"
                class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">
                Clear
            </button>
        </div>
        <h3 class="text-lg font-semibold text-gray-700 mt-4">
            JSON Output:
        </h3>
        <div class="relative">
            <textarea
                id="jsonOutput"
                class="w-full h-40 p-3 border rounded-lg focus:ring-2 focus:ring-green-400 bg-gray-100"
                readonly
            ></textarea>
            <button
                onclick="copyJSON()"
                class="absolute top-2 right-2 bg-green-500 hover:bg-green-600 text-white px-2 py-1 rounded text-sm">
                Copy
            </button>
        </div>
        <button
            onclick="downloadJSON()"
            class="mt-4 w-full bg-purple-500 hover:bg-purple-600 text-white px-4 py-2 rounded-lg">
            Download JSON
        </button>
    </div>
</div>
<script is:inline>
    function convertXML(){
        const xmlText = document.getElementById('xmlInput').value.trim();
        const errorMessage = document.getElementById('errorMessage');
        errorMessage.classList.add('hidden');

        if(!xmlText){
            showError('Please enter XML data.');
            return;
        }
        try{
            const parser = new DOMParser();
            const xml = parser.parseFromString(xmlText, 'application/xml');
            if(xml.getElementsByTagName('parsererror').length){
                throw new Error('Invalid XML format');
            }
            const obj = xmlToJson(xml);
            document.getElementById('jsonOutput').value = JSON.stringify(obj, null, 2);
        } catch(error){
            showError(error.message);
        }
    }
    function xmlToJson(xml){
        let obj = {};
        if(xml.nodeType === 1){
            if(xml.attributes.length > 0){
                obj['@attributes'] = {};
                for(let j = 0; j < xml.attributes.length; j++){
                    const attribute = xml.attributes.item(j);
                    obj['@attributes'][attribute.nodeName] = attribute.nodeValue;
                }
            }
        }

        if(xml.nodeType === 3){
            const text = xml.nodeValue.trim();
            return text ? text : null;
        }

        if(xml.hasChildNodes()){
            for (let i = 0; i < xml.childNodes.length; i++){
                const item = xml.childNodes.item(i);
                const nodeName = item.nodeName;
                const converted = xmlToJson(item);

                if(converted !== null){
                    if(typeof obj[nodeName] === 'undefined'){
                        obj[nodeName] = converted;
                    } else{
                        if(!Array.isArray(obj[nodeName])){
                            obj[nodeName] = [obj[nodeName]];
                        }
                        obj[nodeName].push(converted);
                    }
                }
            }
        }
        if(obj.hasOwnProperty('#text')){
            obj = obj['#text'];
        }
        return obj;
    }

    function showError(message){
        const errorMessage = document.getElementById('errorMessage');
        errorMessage.textContent = message;
        errorMessage.classList.remove('hidden');
    }
    function copyJSON(){
        const output = document.getElementById('jsonOutput');
        output.select();
        document.execCommand('copy');
        showError('JSON copied to clipboard!');
    }

    function downloadJSON(){
        const data = document.getElementById('jsonOutput').value;
        if(!data){
            showError('No JSON data to download.');
            return;
        }
        const blob = new Blob([data], {type: 'application/json'});
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'converted.json';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
    function clearFields(){
        document.getElementById('xmlInput').value = '';
        document.getElementById('jsonOutput').value = '';
        document.getElementById('errorMessage').classList.add('hidden');
    }
</script>