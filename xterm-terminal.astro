<div class="bg-slate-950 min-h-screen flex items-center justify-center p-4 select-none relative overflow-hidden">
    <!-- Ambient cyber glow background -->
    <div class="absolute -top-20 -left-20 w-80 h-80 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-lg bg-slate-900/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-slate-800 relative z-10 overflow-hidden flex flex-col">
        <!-- Terminal Window Header -->
        <div class="h-10 bg-slate-950/90 border-b border-slate-800/80 px-4 flex items-center justify-between select-none">
            <div class="flex items-center space-x-2">
                <div class="w-3 h-3 rounded-full bg-rose-500/80 hover:opacity-100 transition cursor-pointer"></div>
                <div class="w-3 h-3 rounded-full bg-amber-500/80 hover:opacity-100 transition cursor-pointer"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-500/80 hover:opacity-100 transition cursor-pointer"></div>
            </div>
            <div class="text-xs font-mono text-slate-400 flex items-center space-x-1.5">
                <span>⚡</span>
                <span class="font-semibold text-slate-300">webcraft@terminal:~</span>
            </div>
            <div class="text-[10px] font-mono text-slate-500 px-1.5 py-0.5 rounded bg-slate-800/60 border border-slate-700/50">
                xterm.js
            </div>
        </div>

        <!-- Quick Command Action Chips -->
        <div class="bg-slate-900/80 border-b border-slate-800/60 px-4 py-2 flex items-center space-x-2 overflow-x-auto text-xs">
            <span class="text-slate-500 font-mono text-[11px]">Run:</span>
            <button id="cmdHelp" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 active:scale-95 text-cyan-400 font-mono text-xs border border-slate-700/50 transition">help</button>
            <button id="cmdSkills" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 active:scale-95 text-emerald-400 font-mono text-xs border border-slate-700/50 transition">skills</button>
            <button id="cmdAbout" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 active:scale-95 text-purple-400 font-mono text-xs border border-slate-700/50 transition">about</button>
            <button id="cmdClear" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 active:scale-95 text-rose-400 font-mono text-xs border border-slate-700/50 transition">clear</button>
        </div>

        <!-- Terminal Canvas Container -->
        <div id="terminalContainer" class="h-64 p-3 bg-[#0d1117] font-mono text-sm overflow-hidden relative"></div>

        <!-- Terminal Footer & Copy Bar -->
        <div class="p-3 bg-slate-950/80 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs font-mono text-slate-400 flex items-center space-x-1">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse inline-block"></span>
                <span>Interactive CLI Ready</span>
            </span>
            <button id="copyCliBtn" class="bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 active:scale-95 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition shadow-md shadow-cyan-500/20">
                Copy CLI Code
            </button>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js"></script>

<script is:inline>
    // Fallback if CDN is loading or offline
    function initXtermApp() {
        const container = document.getElementById('terminalContainer');
        if (!container) return;

        if (typeof Terminal === 'undefined') {
            container.innerHTML = `
                <div class="h-full flex flex-col justify-center items-start text-xs font-mono space-y-1.5 text-slate-300">
                    <p class="text-cyan-400 font-bold">⚡ WebCraft Terminal (xterm.js engine)</p>
                    <p class="text-slate-400">Type <span class="text-emerald-400">'help'</span> for available commands.</p>
                    <p class="text-slate-500">guest@webcraft:~$ <span class="text-yellow-400">ready</span><span class="animate-pulse">_</span></p>
                </div>`;
            return;
        }

        container.innerHTML = '';
        const term = new Terminal({
            cursorBlink: true,
            fontSize: 13,
            lineHeight: 1.25,
            fontFamily: "'Fira Code', 'Cascadia Code', Menlo, monospace",
            theme: {
                background: '#0d1117',
                foreground: '#c9d1d9',
                cursor: '#58a6ff',
                cursorAccent: '#0d1117',
                selectionBackground: '#1f6feb',
                black: '#484f58',
                red: '#ff7b72',
                green: '#3fb950',
                yellow: '#d29922',
                blue: '#58a6ff',
                magenta: '#bc8cff',
                cyan: '#39c5cf',
                white: '#b1bac4'
            }
        });

        term.open(container);

        const prompt = '\r\n\x1b[1;36mwebcraft\x1b[0m@\x1b[1;32mterminal\x1b[0m:\x1b[1;34m~\x1b[0m$ ';
        let currentLine = '';

        term.writeln('\x1b[1;36m  __          __  _      _____            __ _   \x1b[0m');
        term.writeln('\x1b[1;36m  \\ \\        / / | |    / ____|          / _| |  \x1b[0m');
        term.writeln('\x1b[1;36m   \\ \\  /\\  / /__| |__ | |     _ __ __ _| |_| |_ \x1b[0m');
        term.writeln('\x1b[1;36m    \\ \\/  \\/ / _ \\ \'_ \\| |    | \'__/ _` |  _| __|\x1b[0m');
        term.writeln('\x1b[1;36m     \\  /\\  /  __/ |_) | |____| | | (_| | | | |_ \x1b[0m');
        term.writeln('\x1b[1;36m      \\/  \\/ \\___|_.__/ \\_____|_|  \\__,_|_|  \\__|\x1b[0m');
        term.writeln('');
        term.writeln('  Welcome to \x1b[1;32mWebCraft Interactive Terminal\x1b[0m v2.4');
        term.writeln('  Type \x1b[1;33mhelp\x1b[0m to view all available commands.');
        term.write(prompt);

        function handleCommand(cmd) {
            const clean = cmd.trim();
            if (!clean) {
                term.write(prompt);
                return;
            }

            if (clean === 'help') {
                term.writeln('\r\n\x1b[1;33mAvailable Commands:\x1b[0m');
                term.writeln('  \x1b[1;36mhelp\x1b[0m       - Show this command reference list');
                term.writeln('  \x1b[1;36mskills\x1b[0m     - Display core frontend engineering stack');
                term.writeln('  \x1b[1;36mabout\x1b[0m      - About WebCraft & Devs channel');
                term.writeln('  \x1b[1;36mwhoami\x1b[0m     - Display current terminal session identity');
                term.writeln('  \x1b[1;36mdate\x1b[0m       - Print current system date and UTC time');
                term.writeln('  \x1b[1;36mclear\x1b[0m      - Reset and clear the terminal buffer');
            } else if (clean === 'skills') {
                term.writeln('\r\n\x1b[1;32mTech Stack:\x1b[0m');
                term.writeln('  \x1b[1;34m[Astro]\x1b[0m \x1b[1;36m[Tailwind CSS]\x1b[0m \x1b[1;33m[JavaScript]\x1b[0m \x1b[1;35m[Xterm.js]\x1b[0m');
            } else if (clean === 'about') {
                term.writeln('\r\n\x1b[1;35mWebCraft & Devs:\x1b[0m Daily full-stack & frontend projects with clean code.');
            } else if (clean === 'whoami') {
                term.writeln('\r\ndeveloper@webcraft-devs (uid=1000 gid=1000)');
            } else if (clean === 'date') {
                term.writeln('\r\n' + new Date().toUTCString());
            } else if (clean === 'clear') {
                term.clear();
            } else {
                term.writeln(`\r\n\x1b[1;31mCommand not found:\x1b[0m ${clean}. Try '\x1b[1;33mhelp\x1b[0m'.`);
            }
            term.write(prompt);
        }

        term.onData(data => {
            const code = data.charCodeAt(0);
            if (code === 13) { // Enter key
                handleCommand(currentLine);
                currentLine = '';
            } else if (code === 127 || code === 8) { // Backspace
                if (currentLine.length > 0) {
                    currentLine = currentLine.slice(0, -1);
                    term.write('\b \b');
                }
            } else if (code >= 32) {
                currentLine += data;
                term.write(data);
            }
        });

        // Bind Action Chips
        const bindChip = (id, commandText) => {
            const btn = document.getElementById(id);
            if (!btn) return;
            btn.addEventListener('click', () => {
                term.write(commandText);
                currentLine = commandText;
                setTimeout(() => {
                    handleCommand(currentLine);
                    currentLine = '';
                }, 200);
            });
        };

        bindChip('cmdHelp', 'help');
        bindChip('cmdSkills', 'skills');
        bindChip('cmdAbout', 'about');
        bindChip('cmdClear', 'clear');

        // Copy CLI code button
        const copyBtn = document.getElementById('copyCliBtn');
        if (copyBtn) {
            copyBtn.addEventListener('click', async () => {
                const sampleCode = `import { Terminal } from 'xterm';\nimport 'xterm/css/xterm.css';\n\nconst term = new Terminal({ cursorBlink: true });\nterm.open(document.getElementById('terminal'));\nterm.writeln('Hello from Xterm.js!');`;
                try {
                    await navigator.clipboard.writeText(sampleCode);
                    copyBtn.textContent = 'Copied! ✓';
                    setTimeout(() => { copyBtn.textContent = 'Copy CLI Code'; }, 1800);
                } catch (e) {
                    copyBtn.textContent = 'Copied! ✓';
                }
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initXtermApp);
    } else {
        initXtermApp();
    }
</script>
